Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rootgraphF", "[", "rootLin_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"polpts", ",", "root", ",", "maxr", ",", "rootlabel"}], "}"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "input", " ", "a", " ", "root", " ", "list", " ", "and", " ", "it", " ",
        "outputs", " ", "a", " ", "plot", " ", "on", " ", "polargrid"}], " ", 
      "*)"}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"root", "=", 
       RowBox[{"Flatten", "[", "rootLin", "]"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"maxr", "=", 
       RowBox[{"1.2", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", "root", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"polpts", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Hue", "[", 
            RowBox[{
             FractionBox[
              RowBox[{"m", "-", "1."}], 
              RowBox[{
               RowBox[{"Length", "[", "root", "]"}], "+", "1"}]], ",", "1", 
             ",", "1"}], "]"}], ",", 
           RowBox[{"Point", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{"root", "[", 
                RowBox[{"[", "m", "]"}], "]"}], "]"}], ",", 
              RowBox[{"Im", "[", 
               RowBox[{"root", "[", 
                RowBox[{"[", "m", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"Length", "[", "root", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rootlabel", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             SubscriptBox["z", "m"], ",", " ", "24", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times New Roman\>\""}]}], 
            "]"}], ",", 
           RowBox[{"1.15", "*", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{"root", "[", 
                RowBox[{"[", "m", "]"}], "]"}], "]"}], ",", 
              RowBox[{"Im", "[", 
               RowBox[{"root", "[", 
                RowBox[{"[", "m", "]"}], "]"}], "]"}]}], "}"}]}]}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"Length", "[", "root", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"polargrid", "[", "1", "]"}], ",", 
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"PointSize", "[", "0.05", "]"}], ",", "polpts", ",", 
           "Yellow", ",", "rootlabel"}], "}"}], "]"}], "\[IndentingNewLine]", 
        ",", 
        RowBox[{"PlotRange", "\[Rule]", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "maxr"}], ",", "0.35"}], "}"}], ",", 
           RowBox[{"maxr", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "}"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"Background", "\[Rule]", " ", "Black"}], ",", " ", 
        RowBox[{"ImageSize", "\[Rule]", " ", "300"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"polargrid", "[", "g_", "]"}], ":=", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GrayLevel", "[", "g", "]"}], ",", 
       RowBox[{"Thickness", "[", "0.001", "]"}], ",", 
       RowBox[{"Arrowheads", "[", "0.07", "]"}], "\[IndentingNewLine]", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1.4"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.25", ",", "0"}], "}"}]}], "}"}], "]"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "1.4"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1.4"}], "}"}]}], "}"}], "]"}], 
       "\[IndentingNewLine]", ",", "Dashed", ",", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Circle", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", "r", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Pi", "/", "2"}], ",", 
             RowBox[{"3", " ", 
              RowBox[{"\[Pi]", "/", "2"}]}]}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "0.1", ",", "1.3", ",", "0.2"}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"1.3", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "j"}], ",", 
                 SqrtBox[
                  RowBox[{"1", "-", 
                   SuperscriptBox["j", "2"]}]]}], "}"}]}]}], "}"}], "]"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"Line", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"1.3", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "j"}], ",", 
                 RowBox[{"-", 
                  SqrtBox[
                   RowBox[{"1", "-", 
                    SuperscriptBox["j", "2"]}]]}]}], "}"}]}]}], "}"}], 
            "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0.1", ",", "0.9", ",", "0.1"}], "}"}]}], "]"}]}],
       "}"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TFgraphFunc", "[", 
    RowBox[{"tfparmList_", ",", "var_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tfLoc", ",", "tf", ",", "rangex"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"tfparmList", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"tf1", ",", " ", "plotrange1"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"tf2", ",", " ", "plotrange2"}], "}"}], 
          "\[IndentingNewLine]", ",", "..."}], "}"}], "\[IndentingNewLine]", 
        "var", " ", "is", " ", "the", " ", "symbol", " ", "of", " ", "the", 
        " ", "variable", " ", "in", " ", "the", " ", "TF", " ", 
        "function"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ClearAll", "[", "var", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ListQ", "[", "tfparmList", "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "tfparmList", "]"}], ">", "0"}]}], ",", 
        RowBox[{"tfLoc", "=", "tfparmList"}], ",", 
        RowBox[{"tfLoc", "=", 
         RowBox[{"{", "tfparmList", "}"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "tfLoc", "]"}], ">", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"tf", ",", "rangex"}], "}"}], "=", "u"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Plot3D", "[", 
              RowBox[{
               RowBox[{"10.", 
                RowBox[{"Log", "[", 
                 RowBox[{"10.", ",", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"tf", "/.", " ", 
                    RowBox[{"var", "\[Rule]", " ", 
                    RowBox[{"x", "+", 
                    RowBox[{"\[ImaginaryI]", " ", "y"}]}]}]}], "]"}]}], 
                 "]"}]}], "  ", 
               RowBox[{"(*", " ", 
                RowBox[{"1", "st", " ", "element"}], " ", "*)"}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", 
                 RowBox[{"-", "rangex"}], ",", "rangex"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", 
                 RowBox[{"-", "rangex"}], ",", "rangex"}], "}"}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"ColorFunction", "\[Rule]", "\"\<Rainbow\>\""}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"MeshFunctions", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"#3", "&"}], " ", ",", 
                  RowBox[{"Function", " ", "@@", " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z"}], "}"}], 
                    "\[IndentingNewLine]", ",", 
                    RowBox[{"Arg", "[", 
                    RowBox[{"tf", " ", "/.", " ", 
                    RowBox[{"var", "\[Rule]", " ", 
                    RowBox[{"x", "+", 
                    RowBox[{"\[ImaginaryI]", " ", "y"}]}]}]}], "]"}]}], 
                    "}"}]}]}], " ", "}"}]}], " ", "\[IndentingNewLine]", ",", 
               RowBox[{"MeshStyle", "\[Rule]", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Thickness", "[", "0.001", "]"}], ",", "Orange"}],
                    "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Thickness", "[", "0.001", "]"}], ",", 
                    RowBox[{"GrayLevel", "[", "0.75", "]"}]}], "}"}]}], 
                 "}"}]}], "\[IndentingNewLine]", ",", 
               RowBox[{"PlotPoints", "\[Rule]", " ", 
                RowBox[{"{", 
                 RowBox[{"50", ",", "50"}], "}"}]}], ",", " ", 
               RowBox[{"BoxRatios", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "1", ",", "0.7"}], "}"}]}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"PlotRange", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"rangex", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", 
                  RowBox[{"rangex", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "20"}], ",", "20"}], "}"}]}], "}"}]}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"Background", "\[Rule]", "Black"}], ",", " ", 
               RowBox[{"ImageSize", "\[Rule]", "350"}]}], "]"}], "  ", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", ",", " ", 
             RowBox[{"LogLinearPlot", "[", 
              RowBox[{
               RowBox[{"10", 
                RowBox[{"Log", "[", 
                 RowBox[{"10.", ",", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"(", 
                    RowBox[{"tf", "/.", 
                    RowBox[{"var", "\[Rule]", " ", 
                    RowBox[{
                    "\[ImaginaryI]", " ", "2", " ", "\[Pi]", " ", "f"}]}]}], 
                    ")"}], "]"}]}], "]"}]}], "  ", 
               RowBox[{"(*", " ", 
                RowBox[{"2", "nd", " ", "element"}], " ", "*)"}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"{", 
                RowBox[{"f", ",", "0.001", ",", "100"}], "}"}], 
