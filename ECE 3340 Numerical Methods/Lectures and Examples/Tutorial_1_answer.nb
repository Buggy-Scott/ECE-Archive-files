Cell["\<\
Mass is a most important physical entity that is essential to the definition \
of energy:\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.7558673826095753`*^9, 3.755867449715878*^9}, 
   3.7558760537554955`*^9},ExpressionUUID->"2af14a2e-e423-4b87-8c94-\
418a0d9e6c67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kg", "=."}], ";", " ", 
  RowBox[{"meter", "=."}], ";", " ", 
  RowBox[{"second", "=."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Joule", "=", " ", 
   RowBox[{"kg", " ", "*", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["meter", "second"], ")"}], "2"]}]}], ";"}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.7558674551740065`*^9, 3.7558675339238067`*^9}, 
   3.7558760537554955`*^9},ExpressionUUID->"ecf5de1f-dbf3-41d8-aefe-\
e0963334895d"],

Cell[TextData[{
 "However, since 1899 (or 1900, depending on historical interpretation), \
Planck discovered a fundamental constant of nature: ",
 StyleBox["h",
  FontSlant->"Italic"],
 ", found to be: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6.626070150", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "34"}]], " ", "Joule", " ", "second"}], TraditionalForm]],
  ExpressionUUID->"15296c25-d95e-4fb5-ace7-8a695148cd22"],
 " with a relative uncertainty of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "8"}]], TraditionalForm]],ExpressionUUID->
  "17e0ff95-7e77-4a1c-9d89-caed9fda93cf"],
 ". \nHowever, a fundamental constant of nature with physical unit should not \
have any uncertainty, because the unit is a man-made arbitrary choice, like \
the platinum block above. Hence, on November 16, 2018, the international \
community agreed to ",
 StyleBox["define exactly",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.7558678563729057`*^9, 3.755867863471842*^9}, {
   3.7558680036839514`*^9, 3.7558680345344915`*^9}, {3.7558683329100723`*^9, 
   3.755868342920151*^9}, {3.755868400999946*^9, 3.755868426509924*^9}, {
   3.7558685042297983`*^9, 3.7558685098196545`*^9}, {3.755869936459176*^9, 
   3.755870197922851*^9}, {3.755870238708407*^9, 3.75587027403977*^9}, {
   3.7558716071856403`*^9, 3.75587161523669*^9}, {3.7558726894227743`*^9, 
   3.7558727716955185`*^9}, 
   3.7558760537554955`*^9},ExpressionUUID->"607c1d40-745f-4487-8f35-\
838d8f431983"],

Cell[BoxData[
 RowBox[{"PlanckConstant", "=", 
  RowBox[{
   RowBox[{"6.626070150", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "34"}]], " ", "Joule", " ", "second"}], " ", "/.", " ", 
   RowBox[{"Joule", "\[Rule]", "  ", 
    RowBox[{"kg", " ", "*", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["meter", "second"], ")"}], "2"]}]}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.7558684602197723`*^9, 3.755868488939604*^9}, {
   3.7558717205694866`*^9, 3.755871731159253*^9}, {3.755872000563841*^9, 
   3.755872004154056*^9}, 3.7558760537554955`*^9},
 CellLabel->"In[30]:=",ExpressionUUID->"4f092ac9-56be-4607-9518-c2594c7392bb"],

Cell[BoxData[
 FractionBox[
  RowBox[{"6.6260701500000015`*^-34", " ", "kg", " ", 
   SuperscriptBox["meter", "2"]}], "second"]], "Output",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{3.755872005403892*^9, 3.7558760537554955`*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"b87e4aa9-cf82-4dd1-b7b9-f04651eca423"],

Cell[TextData[{
 "Based on this, write a formula to define the kg such that PlanckConstant is \
exactly ",
 Cell[BoxData[
  RowBox[{"6.626070150", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "34"}]]}]],
  CellChangeTimes->{{3.7558684602197723`*^9, 3.755868488939604*^9}, {
   3.7558717205694866`*^9, 3.755871731159253*^9}, {3.755872000563841*^9, 
   3.755872004154056*^9}},ExpressionUUID->
  "c4b78ebd-7944-46bd-b378-1fd364744c3b"]
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.755872788068754*^9, 3.755872861673751*^9}, {
   3.755873654399352*^9, 3.7558736780201483`*^9}, 
   3.7558760537554955`*^9},ExpressionUUID->"167122db-3f62-479d-9dbe-\
a30c9fd686d5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Answer", "Answer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.7558732405565014`*^9, 3.755873241987082*^9}, 
   3.7558760008055773`*^9},ExpressionUUID->"cca1cc60-97fc-4f85-94e5-\
51de285b71ab"],

Cell[TextData[{
 "We will use ",
 StyleBox["Solve[]",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 " for this question"
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.7558732618372464`*^9, 3.7558732781699224`*^9}, {
   3.755873639894532*^9, 3.755873645769305*^9}, 
   3.7558760008055773`*^9},ExpressionUUID->"c66889b7-448d-4f40-a876-\
c1fff8ca9fc8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PlanckConstant", "=."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"PlanckConstant", "\[Equal]", " ", 
    RowBox[{"6.626070150", "\[Times]", 
     SuperscriptBox["10", 
      RowBox[{"-", "34"}]], "  ", 
     FractionBox[
      RowBox[{"kg", " ", 
       SuperscriptBox["meter", "2"]}], "second"]}]}], ",", "kg"}], 
  "]"}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.7558737677483115`*^9, 3.755873825101245*^9}, 
   3.7558760008055773`*^9},
 CellLabel->"In[32]:=",ExpressionUUID->"d1265db1-d508-4b48-ac8f-28840679c306"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"kg", "\[Rule]", 
    FractionBox[
     RowBox[{
     "1.5091901796421515`*^33", " ", "PlanckConstant", " ", "second"}], 
     SuperscriptBox["meter", "2"]]}], "}"}], "}"}]], "Output",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.755873807784865*^9, 3.7558738260042133`*^9}, 
   3.7558760008055773`*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"2f7c9d92-b674-4028-8ce1-1bd9ac640fd4"],

Cell["\<\
But there is a problem with the above. We have a better solution this way, \
using whole number:\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.7558738940597568`*^9, 3.7558739244222956`*^9}, 
   3.7558760008055773`*^9},ExpressionUUID->"e9ef8d47-c3a5-4286-9497-\
3e32ba19686f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PlanckConstant", "=."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"PlanckConstant", "\[Equal]", " ", 
    RowBox[{
    "\"\<6.626070150\[Times]\!\(\*SuperscriptBox[\(10\), \(-34\)]\)\>\"", " ", 
     FractionBox[
      RowBox[{"kg", " ", 
       SuperscriptBox["meter", "2"]}], "second"]}]}], ",", "kg"}], 
  "]"}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.7558737677483115`*^9, 3.755873825101245*^9}, {
   3.7558739435422897`*^9, 3.755873984007817*^9}, {3.755875451632398*^9, 
   3.755875473176375*^9}, 3.7558760008055773`*^9},
 CellLabel->"In[56]:=",ExpressionUUID->"33a053c4-003b-4089-a6be-cbeb5114db5e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"kg", "\[Rule]", 
    FractionBox[
     RowBox[{"PlanckConstant", " ", "second"}], 
     RowBox[{"\<\"6.626070150\[Times]\\!\\(\\*SuperscriptBox[\\(10\\), \\(-34\
\\)]\\)\"\>", " ", 
      SuperscriptBox["meter", "2"]}]]}], "}"}], "}"}]], "Output",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.7558739659120007`*^9, 3.755873985081015*^9}, {
   3.755875457922844*^9, 3.755875475933188*^9}, 3.755875610412396*^9, 
   3.7558760008055773`*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"e0f82439-bec2-4833-8b32-54e8d294210e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Problem 2.1b", "Exercise",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.755864713697954*^9, 3.7558647181968927`*^9}, {
   3.7558720509812117`*^9, 3.755872057135322*^9}, {3.7558728636192904`*^9, 
   3.755872866075878*^9}, 
   3.755876026175559*^9},ExpressionUUID->"1169c306-9829-4075-b833-\
89d5c52e03e3"],

Cell["What is a meter? A meter is defined to be", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.755874536085929*^9, 3.755874566003132*^9}, 
   3.755876026175559*^9},ExpressionUUID->"dbe4badc-bced-4985-95c0-\
