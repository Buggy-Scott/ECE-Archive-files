Cell["Answer", "Answer",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.754915178682*^9, 3.754915179802*^9}, {3.754915362314*^9,
   3.754915377962*^9}, {3.754915872859*^9, 
  3.7549158808900003`*^9}},ExpressionUUID->"e84491aa-d09a-46a3-becb-\
3aac05c5d50e"],

Cell[TextData[{
 "From KCL: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SubscriptBox["v", "C"]}], "+", 
     RowBox[{"i", " ", "R"}]}], "\[Equal]", "0"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "bb38abd7-7e07-4d20-ad7f-19215d5d4016"],
 "\n       Or:      ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"-", "q"}], "c"], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"\[DifferentialD]", "q"}], 
       RowBox[{"\[DifferentialD]", "t"}]], " ", "R"}]}], " ", "\[Equal]", " ",
     "0"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "1c1bda8e-12d0-4aa0-a8d7-986b728e6364"]
}], "Text",
 CellChangeTimes->{{3.787882451325878*^9, 3.7878825941427097`*^9}, {
  3.787882628509803*^9, 3.787882628509803*^9}, {3.787882774255335*^9, 
  3.787882774255335*^9}},ExpressionUUID->"97a5eb1f-f12f-41f6-a509-\
1e430bd47335"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"q", "[", "t", "]"}], "C"], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"q", "'"}], "[", "t", "]"}], " ", "R"}]}], " ", "\[Equal]", 
      " ", "0"}], " ", ",", 
     RowBox[{
      FractionBox[
       RowBox[{"q", "[", "0", "]"}], "C"], "\[Equal]", " ", "v0"}]}], "}"}], 
   ",", 
   RowBox[{"q", "[", "t", "]"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.7878826503872676`*^9, 3.7878827940633364`*^9}, {
  3.787882830335989*^9, 3.7878828409753785`*^9}, {3.7878830052654605`*^9, 
  3.7878830450710087`*^9}},
 CellLabel->
  "In[123]:=",ExpressionUUID->"7dc4a23e-4ce4-45e8-875a-082859131511"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"q", "[", "t", "]"}], "\[Rule]", 
    RowBox[{"C", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox["t", 
        RowBox[{"C", " ", "R"}]]}]], " ", "v0"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.7878826878810015`*^9, 3.787882794755486*^9}, {
   3.787882833468486*^9, 3.78788284147604*^9}, 3.7878830462050047`*^9},
 CellLabel->
  "Out[123]=",ExpressionUUID->"69edd236-d6d8-4396-aebb-a1f87b2e21b5"]
}, Open  ]],

Cell[TextData[{
 "Thus, voltage is:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"v", "[", "t", "]"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"q", "[", "t", "]"}], "C"], "=", 
     RowBox[{
      SubscriptBox["v", "0"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox["t", 
         RowBox[{"C", " ", "R"}]]}]]}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "8e1e9120-b664-44ae-a96e-06b41c3cd15e"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "0"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "fa451d94-bbea-497e-9940-c33798872e6a"],
 " is the initial voltage at t=0. \nThe current is:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{"-", 
     RowBox[{
      RowBox[{"q", "'"}], "[", "t", "]"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "bafe37c4-0abc-4928-a380-ce5141d9431c"]
}], "Text",
 CellChangeTimes->{{3.7878829096617193`*^9, 3.787882979469139*^9}, {
  3.787883066399002*^9, 3.7878831078234315`*^9}, {3.787883188638669*^9, 
  3.787883188638669*^9}},ExpressionUUID->"6f2d52bc-fbf9-41f0-a64c-\
24f7bfb9d3d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"q", "[", "t_", "]"}], ":=", 
     RowBox[{"C", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox["t", 
         RowBox[{"C", " ", "R"}]]}]], " ", "v0"}]}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{"-", 
    RowBox[{
     RowBox[{"q", "'"}], "[", "t", "]"}], " "}]}]}]], "Input",
 CellChangeTimes->{{3.7878831146441617`*^9, 3.7878831923507385`*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"e904cc2e-e67d-4829-ac37-fcd58a0988c3"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox["t", 
      RowBox[{"C", " ", "R"}]]}]], " ", "v0"}], "R"]], "Output",
 CellChangeTimes->{
  3.787883126150448*^9, {3.7878831792517405`*^9, 3.7878831930521364`*^9}},
 CellLabel->
  "Out[128]=",ExpressionUUID->"bb5b1887-ac95-49e1-8bbf-a36b6910d521"]
}, Open  ]],

Cell[TextData[{
 "Thus:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "[", "t", "]"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{" ", "v0"}], "R"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox["t", 
        RowBox[{"C", " ", "R"}]]}]]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "c7d84846-c25c-4c1d-889e-4f60721bcbed"]
}], "Text",
 CellChangeTimes->{{3.7878832012927823`*^9, 
  3.7878832281639504`*^9}},ExpressionUUID->"b8049b99-ec27-47e6-bc18-\
a6b02e51fe94"],

Cell["Now, we can substitute:", "Text",
 CellChangeTimes->{{3.7878832393250723`*^9, 
  3.7878832465896482`*^9}},ExpressionUUID->"3c47b432-07be-4e50-8efe-\
a50746c4ecd9"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["v", "0"], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox["t", 
          RowBox[{"C", " ", "R"}]]}]]}], " ", "/.", " ", 
      RowBox[{
       SubscriptBox["v", "0"], "\[Rule]", " ", "10"}]}], " ", "/.", " ", 
     RowBox[{"C", "\[Rule]", " ", 
      RowBox[{"500.", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "6"}]]}]}]}], " ", "/.", " ", 
    RowBox[{"R", "\[Rule]", " ", "2000"}]}], " ", "/.", " ", 
   RowBox[{"t", "\[Rule]", " ", "1.5"}]}], TraditionalForm]], "Input",
 CellChangeTimes->{{3.7878832822223854`*^9, 3.7878833331651273`*^9}, {
  3.7878835195989337`*^9, 3.787883520525484*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"ea2fb8c0-e675-482f-b833-1c275b8e815f"],

Cell[BoxData["2.231301601484298`"], "Output",
 CellChangeTimes->{3.787883333809432*^9, 3.7878835212555256`*^9},
 CellLabel->
  "Out[134]=",ExpressionUUID->"9075bab8-b9f8-4a5d-b0e6-259c410146d9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox[
        SubscriptBox["v", "0"], "R"], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox["t", 
          RowBox[{"C", " ", "R"}]]}]]}], " ", "/.", " ", 
      RowBox[{
       SubscriptBox["v", "0"], "\[Rule]", " ", "10"}]}], "  ", "/.", " ", 
     RowBox[{"C", "\[Rule]", " ", 
      RowBox[{"500.", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "6"}]]}]}]}], " ", "/.", " ", 
    RowBox[{"R", "\[Rule]", " ", "2000"}]}], " ", "/.", " ", 
   RowBox[{"t", "\[Rule]", " ", "1.5"}]}], TraditionalForm]], "Input",
 CellChangeTimes->{{3.7878833531028075`*^9, 3.787883372414193*^9}},
 CellLabel->
  "In[131]:=",ExpressionUUID->"a80d7551-d8d1-4fb7-bae6-7995ba9c3f5c"],

Cell[BoxData["0.0011156508007421492`"], "Output",
