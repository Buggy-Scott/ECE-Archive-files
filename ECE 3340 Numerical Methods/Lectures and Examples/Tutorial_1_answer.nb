Cell["Exercise 3.6", "Exercise",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.754914553098*^9, 3.754914557434*^9}, 
   3.754915872859*^9, {3.7554553590950003`*^9, 3.755455361256*^9}, 
   3.7557018583944635`*^9, {3.755703481403969*^9, 3.7557034844813976`*^9}, {
   3.755707250979999*^9, 3.7557072520266266`*^9}, 3.7558630243691196`*^9, {
   3.787881352190534*^9, 3.7878813544145575`*^9}, {3.787884515980254*^9, 
   3.7878845167501955`*^9}, {3.787885146796234*^9, 3.7878851491320343`*^9}, {
   3.7878857936594777`*^9, 
   3.7878857942368364`*^9}},ExpressionUUID->"36222f9c-3ae7-4263-b05f-\
9b6e1c7494c8"],

Cell[TextData[{
 "Consider an AC voltage: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"v", "[", "t", "]"}], "=", 
    RowBox[{
     SubscriptBox["v", "0"], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", "\[Pi]", " ", "f", " ", "t"}], "]"}]}]}], 
   TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "920ebe35-113b-4ab5-bf97-fec8276c68c1"],
 "\nwhere v0 is 120 V, f=60 Hz. What is the voltage value at t=13.5 ms. "
}], "Text",
 CellChangeTimes->{{3.7878858095701284`*^9, 3.7878858126049795`*^9}, {
  3.7878858436120567`*^9, 3.7878858727495813`*^9}, {3.787886118667569*^9, 
  3.7878861259321795`*^9}},ExpressionUUID->"1fe73b15-dffe-4ccd-a64f-\
7046a5370417"],

Cell["Answer", "Answer",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.754915178682*^9, 3.754915179802*^9}, {3.754915362314*^9,
   3.754915377962*^9}, {3.754915872859*^9, 
  3.7549158808900003`*^9}},ExpressionUUID->"af35ac63-12e6-4064-8ead-\
71e8cd58159f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["v", "0"], "=", "120."}], ";", " ", 
   RowBox[{"f", "=", "60."}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["v", "0"], " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"2", " ", "\[Pi]", " ", "f", " ", "t"}], "]"}]}], " ", "/.", " ", 
  RowBox[{"t", "\[Rule]", " ", 
   RowBox[{"13.5", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}]}]}]}], "Input",
 CellChangeTimes->{{3.7878858919877634`*^9, 3.7878859346197243`*^9}, {
  3.78788601138845*^9, 3.787886016075886*^9}, {3.78788605191706*^9, 
  3.7878860539326706`*^9}},
 CellLabel->
  "In[187]:=",ExpressionUUID->"d072ca00-0734-45e0-ac86-1d095ad492c2"],

