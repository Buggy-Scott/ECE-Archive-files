           "], "Byte", ColorSpace -> "RGB", Interleaving -> True]], 
        Grid[{{
           Manipulate[If[
              Not[
               
               TrueQ[$CellContext`\[Gamma]old$64192 == \
$CellContext`\[Gamma]]], $CellContext`root$64192 = ReplaceAll[$CellContext`z, 
                 
                 NSolve[$CellContext`z^2 + $CellContext`\[Omega]n^2 + (
                    2 $CellContext`\[Gamma]) $CellContext`z == 
                  0., {$CellContext`z}]]; If[Abs[
                  Im[$CellContext`z1$64192]] > 
                0, $CellContext`\[Zeta]$64192 = -(
                  Re[$CellContext`z1$64192]/$CellContext`\[Omega]n), \
$CellContext`\[Zeta]$64192 = 
                I]; $CellContext`\[Gamma]old$64192 = $CellContext`\[Gamma], 
              Null]; If[
              Not[
               
               TrueQ[$CellContext`\[Omega]nold$64192 == \
$CellContext`\[Omega]n]], 
              If[
               Im[$CellContext`\[Zeta]$64192] == 
                0, $CellContext`root$64192 = $CellContext`\[Omega]n \
{-$CellContext`\[Zeta]$64192 + 
                   I Sqrt[1 - $CellContext`\[Zeta]$64192^2], -$CellContext`\
\[Zeta]$64192 - I 
                   Sqrt[1 - $CellContext`\[Zeta]$64192^2]}, \
$CellContext`root$64192 = ReplaceAll[$CellContext`z, 
                  
                  NSolve[$CellContext`z^2 + $CellContext`\[Omega]n^2 + (
                    2 $CellContext`\[Gamma]) $CellContext`z == 
                   0., {$CellContext`z}]]]; $CellContext`\[Omega]nold$64192 = \
$CellContext`\[Omega]n, 
              Null]; {$CellContext`z1$64192, $CellContext`z2$64192} = \
$CellContext`root$64192; $CellContext`\[CapitalDelta]z$64192 = 
             Abs[$CellContext`z1$64192 - $CellContext`z2$64192]; \
$CellContext`plotparmx$64192 = {
              0., 1.5, {{0.01, 0.07, 0.032}, Null}, {0.002, 
               0.5}}; $CellContext`respgraph = Plot[{
                UnitStep[$CellContext`t], 
                
                If[$CellContext`\[CapitalDelta]z$64192 > 10^(-4), 
                 1 + ($CellContext`z2$64192/($CellContext`z1$64192 - \
$CellContext`z2$64192)) 
                  E^($CellContext`t $CellContext`z1$64192) + \
