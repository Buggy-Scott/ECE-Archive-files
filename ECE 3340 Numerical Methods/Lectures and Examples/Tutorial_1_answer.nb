           Circle[], 
           Arrowheads[0.025], 
           Arrow[{{0, -1.2}, {0, 1.2}}], 
           Arrow[{{1.2, 0}, {-1.2, 0}}], 
           Thickness[0.002], 
           GrayLevel[0.5], 
           Dashing[{0.0025, 0.0035}], 
           Table[
            If[$CellContext`m != 0, 
             Line[{{0.5 $CellContext`m, -1}, {0.5 $CellContext`m, 1}}], 
             Point[{0, 0}]], {$CellContext`m, -2, 10, 1}], 
           Table[
            
            Line[{{-1, 0.5 $CellContext`m}, {
              5, 0.5 $CellContext`m}}], {$CellContext`m, -2, 2, 1}], White, 
           Text["x", {-0.15, 1.15}], 
           Text["y", {-1.15, 0.15}]}]; $CellContext`phasor[
          Pattern[$CellContext`t, 
           Blank[]], 
          Pattern[$CellContext`tscl, 
           Blank[]], 
          Pattern[$CellContext`aH, 
           Blank[]], 
          Pattern[$CellContext`\[Phi]x, 
           Blank[]], 
          Pattern[$CellContext`parm, 
           Blank[]]] := 
        Block[{$CellContext`hv, $CellContext`sv, $CellContext`bv, \
$CellContext`ha, $CellContext`sa, $CellContext`ba, $CellContext`opaca, \
$CellContext`thck, $CellContext`arrh, $CellContext`thckD, $CellContext`xpts, \
$CellContext`xpts0}, {{$CellContext`thck, $CellContext`arrh, \
$CellContext`thckD}, {$CellContext`hv, $CellContext`sv, $CellContext`bv}, \
{$CellContext`ha, $CellContext`sa, $CellContext`ba, $CellContext`opaca}} = \
$CellContext`parm; $CellContext`xpts0 = 
           Table[{$CellContext`x $CellContext`tscl + 1., $CellContext`aH 
              Cos[(2 Pi) ($CellContext`x - $CellContext`t) + $CellContext`\
\[Phi]x]}, {$CellContext`x, 0, 4/$CellContext`tscl, 0.02}]; $CellContext`xpts = 
           Join[{{
               Part[$CellContext`xpts0, 1, 1], 0}}, $CellContext`xpts0, {{
               Part[
                Last[$CellContext`xpts0], 1], 0}}]; Graphics[{White, Dashed, 
             Thickness[$CellContext`thckD], 
             
             Line[{{1, $CellContext`aH 
                Cos[((-2) 
                    Pi) $CellContext`t + $CellContext`\[Phi]x]}, \
$CellContext`aH {-Sin[((-2) Pi) $CellContext`t + $CellContext`\[Phi]x], 
                 Cos[((-2) Pi) $CellContext`t + $CellContext`\[Phi]x]}}], 
             Hue[$CellContext`hv, $CellContext`sv, $CellContext`bv, 1], 
             Thickness[$CellContext`thck], 
             Dashing[{1, 0}], 
             Arrowheads[$CellContext`arrh], 
             
             Arrow[{{0, 
               0}, $CellContext`aH {-
                 Sin[((-2) Pi) $CellContext`t + $CellContext`\[Phi]x], 
                 Cos[((-2) Pi) $CellContext`t + $CellContext`\[Phi]x]}}], 
             Thickness[$CellContext`thck 1.5], 
             Line[$CellContext`xpts0], 
             
             Hue[$CellContext`ha, $CellContext`sa, $CellContext`ba, \
$CellContext`opaca], 
             Polygon[$CellContext`xpts], 
             
             Hue[$CellContext`ha, $CellContext`sa, $CellContext`ba, \
$CellContext`opaca], 
             
             Disk[{0., 0.}, 
              0.3, {$CellContext`\[Phi]x - (2 Pi) $CellContext`t + Pi/2., Pi/
               2.}]}]]; Null}; Typeset`initDone$$ = True),
