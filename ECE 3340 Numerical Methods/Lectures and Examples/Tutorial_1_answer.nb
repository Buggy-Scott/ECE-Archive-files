Cell[CellGroupData[{

Cell["1. Data and variables - basic", "Section",
 CellChangeTimes->{{3.754911066314*^9, 3.754911073722*^9}, {3.754912597513*^9,
   3.754912601258*^9}},ExpressionUUID->"2b5f0930-4590-4d61-91f7-140e64082462"],

Cell[CellGroupData[{

Cell["1.1 Data on the internal stack (work space)", "Subsection",
 CellChangeTimes->{{3.755523172696*^9, 
  3.7555232042799997`*^9}},ExpressionUUID->"952fb50a-4c29-4da0-85e8-\
92b801ae49ad"],

Cell["\<\
Example of data: voltage = 5.2 volt. Here is the representation of the data\
\>", "Text",
 CellChangeTimes->{{3.7549126201070004`*^9, 3.754912686922*^9}, {
  3.755523212711*^9, 3.7555232237349997`*^9}, {3.755523272999*^9, 
  3.7555232733190002`*^9}},ExpressionUUID->"0cacb7b8-755f-4b24-bfc3-\
d512bd348758"],

Cell[CellGroupData[{

Cell[BoxData["5.2"], "Input",
 CellChangeTimes->{{3.7549126788*^9, 3.754912679738*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"9c21f3d8-298f-4737-a796-73bb022b151a"],

Cell[BoxData["5.2`"], "Output",
 CellChangeTimes->{3.7549126918450003`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"1ae77685-cf65-48a5-9634-7bb3c37e1f73"]
}, Open  ]],

Cell[TextData[{
 "The data is stored in the \[OpenCurlyDoubleQuote]stack\
\[CloseCurlyDoubleQuote]. We access it with this command: ",
 StyleBox["%",
  FontFamily->"Consolas",
  FontSize->24,
  FontWeight->"Bold",
  FontColor->RGBColor[0, 0, 1]]
}], "Text",
 CellChangeTimes->{{3.75491273049*^9, 
  3.754912768186*^9}},ExpressionUUID->"b2f97f09-5df6-4a32-9b24-be318b321f91"],

Cell[CellGroupData[{

Cell[BoxData["%"], "Input",
 CellChangeTimes->{3.754912720752*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"2317b411-8786-4270-95b5-f2d3d9183a42"],

Cell[BoxData["5.2`"], "Output",
 CellChangeTimes->{3.754912721526*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"221e0492-ca5c-4092-89a7-4a884a2cbc17"]
}, Open  ]],

Cell["\<\
It is more convenient to assign a name to a data so that we can \
\[OpenCurlyDoubleQuote]call\[CloseCurlyDoubleQuote] it whenever needed. This \
\[OpenCurlyDoubleQuote]name\[CloseCurlyDoubleQuote] represents a \
\[OpenCurlyDoubleQuote]variable,\[CloseCurlyDoubleQuote] and this is how a \
\[OpenCurlyDoubleQuote]variable\[CloseCurlyDoubleQuote] is created and \
assigned:\
\>", "Text",
 CellChangeTimes->{{3.754912837882*^9, 3.754912889962*^9}, {
  3.7549140251140003`*^9, 
  3.754914147242*^9}},ExpressionUUID->"843304a3-3f47-48cf-aa67-02567c7a06e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.2 Assigment of value to a variable", "Subsection",
 CellChangeTimes->{{3.755523172696*^9, 3.7555232042799997`*^9}, {
  3.755523304119*^9, 3.7555233310480003`*^9}, {3.755860612618617*^9, 
  3.7558606171175585`*^9}},ExpressionUUID->"e2a1041c-67eb-4b3d-9fa0-\
3948828920d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"voltage", "=", "5.2"}]], "Input",
 CellChangeTimes->{{3.75491289376*^9, 3.7549128989709997`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"e8f5a875-823f-4a24-943c-74d2055d60f0"],

Cell[BoxData["5.2`"], "Output",
 CellChangeTimes->{3.7549129002460003`*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"ab82bf3b-41e8-4f0d-a236-ef465808b920"]
}, Open  ]],

Cell["We can make a note (comment) of its unit like this:", "Text",
 CellChangeTimes->{{3.754914702954*^9, 
  3.7549147214820004`*^9}},ExpressionUUID->"b1381c2a-fc30-402c-986d-\
be6229b7d531"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"voltage", "=", "5.2", " ", 
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "unit", " ", "is", " ", "Volt"}], " ", 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.754914724591*^9, 
  3.754914753402*^9}},ExpressionUUID->"245100a4-a547-4986-8275-3ff27eb98eff"],

Cell[BoxData["5.2`"], "Output",
 CellChangeTimes->{3.754914743593*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"84bcdb79-4088-4668-9c76-3679a3703dfc"]
}, Open  ]],

Cell[TextData[{
 "Or, perhaps we can define a variable with explicit undefined variable \
\[OpenCurlyDoubleQuote]",
 StyleBox["Volt",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.7549147835299997`*^9, 3.754914805898*^9}, {
  3.755437584392*^9, 
  3.75543759892*^9}},ExpressionUUID->"00d70bee-5315-4c5b-b39f-2058f968820c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"voltage", "=", 
  RowBox[{"5.2", " ", "Volt"}]}]], "Input",
 CellChangeTimes->{{3.754914724591*^9, 3.754914768314*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"ea420396-0900-4a13-a1fc-26fa5f06aa2e"],

Cell[BoxData[
 RowBox[{"5.2`", " ", "Volt"}]], "Output",
 CellChangeTimes->{3.754914773172*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"5a3f831f-18d4-493d-a707-7321ca8edd10"]
}, Open  ]],

Cell["We can retrieve the value anytime we call it:", "Text",
 CellChangeTimes->{{3.75491526241*^9, 3.75491529305*^9}, {3.75552334604*^9, 
  3.7555233494639997`*^9}},ExpressionUUID->"b068fd4d-9b69-44f0-93a0-\
62f5ae5ae2a0"],

Cell[CellGroupData[{

Cell[BoxData["voltage"], "Input",
 CellChangeTimes->{{3.75491529704*^9, 3.754915301594*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"90679ac7-9e5e-4e59-a93f-95abe05671c5"],

Cell[BoxData[
 RowBox[{"5.2`", " ", "Volt"}]], "Output",
 CellChangeTimes->{3.754915301957*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"2ef5b5c5-0631-43bb-ad23-09fc401a06c9"]
}, Open  ]],

Cell["Consider this statement:", "Text",
 CellChangeTimes->{{3.755523358808*^9, 
  3.755523362984*^9}},ExpressionUUID->"4155c074-5982-4a21-a099-8394ee6b4af9"],

Cell[BoxData[
 RowBox[{"voltage", " ", ";"}]], "Input",
 CellChangeTimes->{{3.7549169004820004`*^9, 3.7549169028900003`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"17d7d8d0-49b3-4ed7-9641-40a912f90394"],

Cell[TextData[{
 "Why don\[CloseCurlyQuote]t we see any output? It is because of \
\[OpenCurlyDoubleQuote]",
 StyleBox[";",
  FontFamily->"Consolas",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 1.]],
 "\[CloseCurlyDoubleQuote]. Semi-colon is a statement terminator: it \
terminates a statement and suppresses the printout of the output. The output \
is still on the internal stack. It is simply not printed out on the user \
interface."
}], "Text",
 CellChangeTimes->{{3.754916907418*^9, 3.754916973946*^9}, {3.754917018314*^9,
   3.7549171429379997`*^9}},ExpressionUUID->"dcd0d542-1716-4dba-a833-\
bbf0c155b104"],

Cell["\<\
When is it useful? When we don\[CloseCurlyQuote]t want to see irrelevant \
intermediate calculation results of a program, or when the output is too much \
to look at. We should use it almost all the time, except for the final output \
we wish to see.\
\>", "Text",
 CellChangeTimes->{{3.754917180058*^9, 3.7549172828900003`*^9}, {
  3.755437080376*^9, 3.755437149704*^9}, {3.7557000070295753`*^9, 
  3.7557000218525*^9}},ExpressionUUID->"4305331b-6169-41b6-8fc6-84cdccbb1321"],

Cell[CellGroupData[{

Cell["Exercise 1.1", "Exercise",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.754914553098*^9, 3.754914557434*^9}, {3.755437367176*^9,
    3.75543736804*^9}, 
   3.7558615768092327`*^9},ExpressionUUID->"005744ae-bb00-4917-894e-\
90dd51d6cc3f"],

Cell[TextData[{
 "Define a variable named \[OpenCurlyDoubleQuote]",
 StyleBox["current",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] and assign it the value of ",
 StyleBox["2.5",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 " (unit: mA). Then, show you can retrieve its value."
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.754914564843*^9, 3.754914590682*^9}, {3.754914652362*^9,
    3.754914675178*^9}, {3.7549151282060003`*^9, 3.754915132858*^9}, {
   3.75491531025*^9, 3.754915327738*^9}, 3.754915371546*^9, 
   3.7558615768092327`*^9},ExpressionUUID->"a094701b-967a-4816-bacf-\
bbee70e69b33"]
}, Open  ]],

