  RowBox[{"b", "=", " ", "153222417."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pab", "=", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"a", "-", "b"}]]}]}], "Input",
