Cell["\<\
The dimension above indicates that rootpr is a 3x2 array. But we want just a \
single list of 6. To do that, we need to flatten it by one level:\
\>", "Text",
 CellChangeTimes->{{3.7601238253667974`*^9, 
  3.760123888664464*^9}},ExpressionUUID->"054b1cfd-b5f1-48fa-b97b-\
d43c8649697a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rootpr1", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"rootpr", ",", "1"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.760123893620183*^9, 3.7601239094594965`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"34f23021-f7b5-4f15-8f44-b7b3eb83cce8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "\[Eta]1"}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["\[Eta]1", "2"]}]]}]}], ")"}], " ", "\[Omega]1"}], 
   ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "\[Eta]1"}], "-", 
      RowBox[{"\[ImaginaryI]", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["\[Eta]1", "2"]}]]}]}], ")"}], " ", "\[Omega]1"}], 
   ",", 
   RowBox[{
    RowBox[{"(", 
