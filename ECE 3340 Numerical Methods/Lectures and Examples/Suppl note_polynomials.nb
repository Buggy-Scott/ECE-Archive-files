                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Thickness", "[", "0.01", "]"}], ",", 
                  RowBox[{"Hue", "[", 
                   RowBox[{"0.8", ",", "0.8", ",", "1"}], "]"}]}], "}"}]}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"Filling", "\[Rule]", " ", 
                RowBox[{"{", 
                 RowBox[{"1", "\[Rule]", " ", 
                  RowBox[{"{", 
                   RowBox[{"Bottom", ",", 
                    RowBox[{"Hue", "[", 
