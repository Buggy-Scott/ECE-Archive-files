      RowBox[{"-", "\[Eta]2"}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["\[Eta]2", "2"]}]]}]}], ")"}], " ", "\[Omega]2"}], 
   ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "\[Eta]2"}], "-", 
      RowBox[{"\[ImaginaryI]", " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["\[Eta]2", "2"]}]]}]}], ")"}], " ", "\[Omega]2"}], 
   ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "\[Eta]3"}], "+", 
