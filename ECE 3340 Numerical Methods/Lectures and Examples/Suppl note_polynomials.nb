Notebook[{

Cell[CellGroupData[{
Cell["Generic ECE-3340 supplementary note: Polynomials", "Title",
 CellChangeTimes->{{3.75994484883644*^9, 3.759944870244168*^9}, {
  3.7599449060853558`*^9, 
  3.7599449256638823`*^9}},ExpressionUUID->"7cad83f2-893e-4c96-b8d5-\
968a00207d81"],

Cell[CellGroupData[{

Cell["1. What is a polynomial", "Section",
 CellChangeTimes->{{3.7598717631494703`*^9, 
  3.7598717859933796`*^9}},ExpressionUUID->"ece7a6dd-6ec9-487b-9472-\
86b41ca293f2"],

Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "x"}], "+", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "45fca4fd-350c-4005-ad30-1c67963a442e"],
 " ;  ",
 StyleBox["x",
  FontSlant->"Italic"],
 " is a variable. It is a polynomial of ",
 StyleBox["x",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.7598717949763694`*^9, 3.7598718450892987`*^9}, {
  3.7598720806391287`*^9, 
  3.759872088032379*^9}},ExpressionUUID->"d3e47332-f98b-4f76-a894-\
f5630c57719c"],

Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"5", " ", "q", " ", 
     SuperscriptBox["x", "2"]}], " ", "+", 
    SuperscriptBox["c", "2"], " ", "-", "8"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "653e9ef2-47d5-4c23-9ab6-c492e38cbd58"],
 "; ",
 StyleBox["x",
  FontSlant->"Italic"],
 " and ",
 StyleBox["c",
  FontSlant->"Italic"],
 " are constant (can be unknown), ",
 StyleBox["q",
  FontSlant->"Italic"],
 " is a variable. Then it is a polynomial of ",
 StyleBox["q",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.759871856718253*^9, 3.7598718761142993`*^9}, {
  3.75987198952896*^9, 
  3.7598720951543283`*^9}},ExpressionUUID->"f2daf79f-3371-461c-b7ad-\
d9a2312897e8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], " ", "y"}], " ", "-", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"x", "+", 
       SuperscriptBox["y", "3"]}], ")"}]}], " ", "+", "7"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "4e2cff9d-b52a-4749-a11c-ddc1b12c5845"],
 " is a polynomial of ",
 StyleBox["x",
  FontSlant->"Italic"],
 " and ",
 StyleBox["y",
  FontSlant->"Italic"],
 " if both are variables."
}], "Text",
 CellChangeTimes->{{3.759872152177846*^9, 3.759872195799055*^9}, {
  3.759872320509491*^9, 3.759872321438009*^9}, {3.759872499042909*^9, 
  3.7598724995864277`*^9}},ExpressionUUID->"e5f7145c-a0cc-40a1-8200-\
540867242c9b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], " ", "y"}], " ", "-", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"x", "+", 
       SuperscriptBox["y", "3"]}], ")"}]}], " ", "+", "7"}], " ", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], "\[IndentingNewLine]", ",", 
   RowBox[{"MeshFunctions", "\[Rule]", 
