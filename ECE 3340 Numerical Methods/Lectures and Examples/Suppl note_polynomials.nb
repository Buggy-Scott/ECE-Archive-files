Cell["Let\[CloseCurlyQuote]s do a plot test:", "Text",
 CellChangeTimes->{{3.760124654957057*^9, 
  3.7601246629866295`*^9}},ExpressionUUID->"695058de-df98-47ae-8347-\
ba60694ffdd5"],

