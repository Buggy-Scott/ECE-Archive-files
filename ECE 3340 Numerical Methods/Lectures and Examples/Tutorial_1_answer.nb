Cell["\<\
For circuit in Exercise 3.2, how long does it take from the moment of \
discharge to the time when the capacitor voltage is 2 V? \
\>", "Text",
 CellChangeTimes->{{3.7878851578825865`*^9, 
  3.787885185915717*^9}},ExpressionUUID->"ffc39a70-c683-4fad-881e-\
64708eb4b5eb"],

Cell["Answer", "Answer",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.754915178682*^9, 3.754915179802*^9}, {3.754915362314*^9,
   3.754915377962*^9}, {3.754915872859*^9, 
  3.7549158808900003`*^9}},ExpressionUUID->"75fa5f97-6b79-4fb0-bc69-\
2ec1ceaf8301"],

Cell[TextData[{
 "From the above, the voltage is:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"v", "[", "t", "]"}], "\[Equal]", " ", 
    RowBox[{
     SubscriptBox["v", "0"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox["t", 
        RowBox[{"C", " ", "R"}]]}]]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "381746e0-738f-42ea-952c-679c95200df0"],
 "\nthen:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"v", "[", "t", "]"}], 
     SubscriptBox["v", "0"]], "\[Equal]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox["t", 
       RowBox[{"C", " ", "R"}]]}]], "  "}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d1268cf1-9bdb-492b-a0cf-25108b41df41"],
 "\nAnd;  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Log", "[", 
     FractionBox[
      RowBox[{"v", "[", "t", "]"}], 
      SubscriptBox["v", "0"]], "]"}], " ", "\[Equal]", 
    RowBox[{"-", 
     FractionBox["t", 
      RowBox[{"C", " ", "R"}]], "  "}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "3307bf31-d579-4e27-9eaf-0675b6699115"],
 "\nor:    ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{
     RowBox[{"-", "R"}], " ", "C", "  ", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"v", "[", "t", "]"}], 
       SubscriptBox["v", "0"]], "]"}], " "}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "ce8b784b-b09b-4e12-9465-3b8af4bf3446"]
}], "Text",
 CellChangeTimes->{{3.7878852221298084`*^9, 
  3.787885378990487*^9}},ExpressionUUID->"7da0d3a3-5fb3-43ff-995f-\
d19b6a4a8c60"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "R"}], " ", "C", "  ", 
       RowBox[{"Log", "[", 
        FractionBox[
         SubscriptBox["v", "1"], 
         SubscriptBox["v", "0"]], "]"}]}], "  ", "/.", " ", 
      RowBox[{"R", "\[Rule]", " ", "2000."}]}], " ", "/.", " ", 
     RowBox[{"C", "\[Rule]", " ", 
      RowBox[{"500.", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}]}], " ", "/.", " ", 
    RowBox[{
     SubscriptBox["v", "0"], "\[Rule]", " ", "10"}]}], "  ", "/.", " ", 
   RowBox[{
    SubscriptBox["v", "1"], "\[Rule]", " ", "2", " "}]}], 
  TraditionalForm]], "Input",
 CellChangeTimes->{{3.787885398397587*^9, 3.787885457340583*^9}},
 CellLabel->
  "In[171]:=",ExpressionUUID->"61bf1ca4-077a-48e0-a313-efda123fa6f6"],

Cell[BoxData["1.6094379124341003`"], "Output",
 CellChangeTimes->{3.7878854580367193`*^9},
 CellLabel->
  "Out[171]=",ExpressionUUID->"25e55937-4055-49ee-9381-e203670f57d5"]
}, Open  ]],

