Cell[CellGroupData[{

Cell["\<\
2. For a single-variable polynomial, what are the most fundamental parameters\
\>", "Section",
 CellChangeTimes->{{3.7598717631494703`*^9, 3.7598717859933796`*^9}, {
  3.759872414168935*^9, 3.759872452806572*^9}, {3.7598725082453637`*^9, 
  3.759872524523744*^9}, {3.7598731478616943`*^9, 
  3.759873158973068*^9}},ExpressionUUID->"3546338d-5e0f-4af4-a0b9-\
34c36066f2ae"],

Cell[TextData[{
 "Consider:           ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["4",
      FontWeight->"Bold"], 
     SuperscriptBox["x", "4"]}], "-", 
    RowBox[{
     StyleBox["28",
      FontWeight->"Bold"], 
     SuperscriptBox["x", "3"]}], "+", 
    RowBox[{
     StyleBox["69",
      FontWeight->"Bold"], " ", 
     SuperscriptBox["x", "2"]}], "-", 
    RowBox[{
     StyleBox["97",
      FontWeight->"Bold"], "x"}], "+", 
    StyleBox["52",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "3e361cb4-da5f-4b3f-a31a-6eae6b6ac7f9"],
 "\nAre coefficients ",
 StyleBox["4,        28,      69,      -97,      52",
  FontWeight->"Bold"],
 " \nthe most fundamental parameters of the polynomial?"
}], "Text",
 CellChangeTimes->{{3.759872560835575*^9, 3.7598726622333183`*^9}, {
  3.7598728411586905`*^9, 3.759872921258437*^9}, {3.7600300597129183`*^9, 
  3.7600300849254427`*^9}},ExpressionUUID->"b463fade-6794-4b84-87fc-\
c37a47d8e1a1"],

Cell["No. It is this:", "Text",
 CellChangeTimes->{{3.759872531383364*^9, 3.759872542207409*^9}, {
  3.7598726659773035`*^9, 
  3.7598726709760265`*^9}},ExpressionUUID->"23bfee34-b78a-424d-8787-\
5a21ebe2ac77"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"4", 
      SuperscriptBox["x", "4"]}], "-", 
     RowBox[{"28", 
      SuperscriptBox["x", "3"]}], "+", 
     RowBox[{"69", " ", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"97", "x"}], "+", "52"}], "\[Equal]", "0"}], ",", "x"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.759872675533737*^9, 3.7598727026512203`*^9}, 
   3.7598729348400755`*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"d6f5a291-c847-4840-ba83-ce12ee4a354a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     StyleBox["1",
      FontColor->RGBColor[1, 0, 0]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     StyleBox[
      RowBox[{"1", "-", 
       FractionBox[
        RowBox[{"3", " ", "\[ImaginaryI]"}], "2"]}],
      FontColor->RGBColor[0., 0.5019607843137255, 0.]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     StyleBox[
      RowBox[{"1", "+", 
       FractionBox[
        RowBox[{"3", " ", "\[ImaginaryI]"}], "2"]}],
      FontColor->RGBColor[0.5019607843137255, 0., 1.]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     StyleBox["4",
      FontColor->RGBColor[0.8352941176470589, 0.41568627450980394`, 0.]]}], 
    "}"}]}], "}"}]], "Input",
 CellChangeTimes->{3.760030132796379*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"a5eceae0-efbb-4f7a-ad2e-1ca4b3fb7aab"],

Cell["\<\
It is the zeros or roots that are fundamental to a polynomial. We construct a \
polynomial from the roots (up).\
\>", "Text",
 CellChangeTimes->{{3.759872953621832*^9, 3.7598729896621833`*^9}, {
  3.7599450171551275`*^9, 
  3.75994502932158*^9}},ExpressionUUID->"33663337-5edf-4a39-ac97-\
6e4b3217e25c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "-", 
     StyleBox["1",
      FontColor->RGBColor[1, 0, 0]]}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "-", 
     RowBox[{"(", 
      StyleBox[
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"3", " ", "\[ImaginaryI]"}], "2"]}],
       FontColor->RGBColor[0., 0.5019607843137255, 0.]], ")"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "-", 
     RowBox[{"(", 
      StyleBox[
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"3", " ", "\[ImaginaryI]"}], "2"]}],
       FontColor->RGBColor[0.5019607843137255, 0., 1.]], ")"}]}], ")"}], "  ", 
   RowBox[{"(", 
    RowBox[{"x", "-", 
     StyleBox["4",
      FontColor->RGBColor[0.8352941176470589, 0.41568627450980394`, 0.]]}], 
    ")"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.759872723454567*^9, 3.75987283259859*^9}, {
  3.7598730057289248`*^9, 3.7598730293607054`*^9}, {3.7600301981276064`*^9, 
  3.7600302430235014`*^9}},
 CellLabel->
  "In[247]:=",ExpressionUUID->"425eba3c-9ea6-4c66-b6b5-1d02016a1fec"],

Cell[BoxData[
 RowBox[{"13", "-", 
  FractionBox[
   RowBox[{"97", " ", "x"}], "4"], "+", 
  FractionBox[
   RowBox[{"69", " ", 
    SuperscriptBox["x", "2"]}], "4"], "-", 
  RowBox[{"7", " ", 
   SuperscriptBox["x", "3"]}], "+", 
  SuperscriptBox["x", "4"]}]], "Output",
 CellChangeTimes->{
  3.7598727031429048`*^9, {3.759872794409752*^9, 3.759872833902133*^9}, 
   3.7598730320654697`*^9, 3.7600302445973196`*^9},
 CellLabel->
  "Out[247]=",ExpressionUUID->"08129424-bcab-45b2-aca3-ffe42054df48"]
}, Open  ]],

Cell["We need just a proportional constant:", "Text",
 CellChangeTimes->{{3.7598730499506407`*^9, 
  3.759873076007949*^9}},ExpressionUUID->"4169d3a8-4ebd-4ffd-aec1-\
a2884e04c1ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{"4", "*", 
   RowBox[{"(", 
    RowBox[{"x", "-", 
     StyleBox["1",
      FontColor->RGBColor[1, 0, 0]]}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "-", 
     RowBox[{"(", 
      StyleBox[
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"3", " ", "\[ImaginaryI]"}], "2"]}],
       FontColor->RGBColor[0., 0.5019607843137255, 0.]], ")"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "-", 
     RowBox[{"(", 
      StyleBox[
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"3", " ", "\[ImaginaryI]"}], "2"]}],
       FontColor->RGBColor[0.5019607843137255, 0., 1.]], ")"}]}], ")"}], "  ", 
   RowBox[{"(", 
    RowBox[{"x", "-", 
     StyleBox["4",
      FontColor->RGBColor[0.8352941176470589, 0.41568627450980394`, 0.]]}], 
    ")"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.759872723454567*^9, 3.75987283259859*^9}, {
   3.7598730057289248`*^9, 3.7598730293607054`*^9}, {3.759873086509821*^9, 
   3.7598730878482404`*^9}, 3.760030265752697*^9},
 CellLabel->
  "In[248]:=",ExpressionUUID->"cf46b545-f8ac-4dbf-95ce-7080a7a0131b"],

Cell[BoxData[
 RowBox[{"52", "-", 
  RowBox[{"97", " ", "x"}], "+", 
  RowBox[{"69", " ", 
   SuperscriptBox["x", "2"]}], "-", 
  RowBox[{"28", " ", 
   SuperscriptBox["x", "3"]}], "+", 
  RowBox[{"4", " ", 
   SuperscriptBox["x", "4"]}]}]], "Output",
 CellChangeTimes->{3.7598730887029543`*^9, 3.760030267992705*^9},
 CellLabel->
  "Out[248]=",ExpressionUUID->"75063648-e5e2-49ad-a745-8b446e507213"]
}, Open  ]],

Cell[TextData[{
 "Hence: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"4", 
      SuperscriptBox["x", "4"]}], "-", 
     RowBox[{"28", 
      SuperscriptBox["x", "3"]}], "+", 
     RowBox[{"69", " ", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"97", "x"}], "+", "52"}], "=", " ", 
    RowBox[{"4", " ", "*", 
     RowBox[{"(", 
      RowBox[{"x", "-", 
       StyleBox["1",
        FontColor->RGBColor[1, 0, 0]]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"x", "-", 
       RowBox[{"(", 
        StyleBox[
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"3", " ", "\[ImaginaryI]"}], "2"]}],
         FontColor->RGBColor[0., 0.5019607843137255, 0.]], ")"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"x", "-", 
       RowBox[{"(", 
        StyleBox[
         RowBox[{"1", "+", 
          FractionBox[
           RowBox[{"3", " ", "\[ImaginaryI]"}], "2"]}],
         FontColor->RGBColor[0.5019607843137255, 0., 1.]], ")"}]}], ")"}], "  ", 
     RowBox[{"(", 
      RowBox[{"x", "-", 
       StyleBox["4",
        FontColor->RGBColor[0.8352941176470589, 0.41568627450980394`, 0.]]}], 
      ")"}], " "}]}], TraditionalForm]],ExpressionUUID->
  "cee05d5c-8697-4ecd-8649-95ad72e5c137"]
}], "Text",
 CellChangeTimes->{{3.759873093929971*^9, 3.7598731339120407`*^9}, {
  3.7600302922627773`*^9, 
  3.7600303151854835`*^9}},ExpressionUUID->"d555fee9-c6c9-4761-b847-\
67cdc3f7f3c8"],

Cell[TextData[{
 "For a real-coefficient polynomial, the fundamental way to express it is:\n  \
                   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Q", "[", "s", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"s", "-", 
          SubscriptBox["z", "1"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"s", "-", 
          SubscriptBox[
           OverscriptBox["z", "_"], "1"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"s", "-", 
          SubscriptBox["z", "2"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"s", "-", 
          SubscriptBox[
           OverscriptBox["z", "_"], "2"]}], ")"}]}], " ", "..."}], " ", 
      RowBox[{"(", 
       RowBox[{"s", "-", 
        SubscriptBox["z", "n"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"s", "-", 
        SubscriptBox[
         OverscriptBox["z", "_"], "n"]}], ")"}], "  ", 
      RowBox[{"(", 
       RowBox[{"s", "-", 
        SubscriptBox["u", "1"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"s", "-", 
        SubscriptBox["u", "2"]}], ")"}]}], " ", "..."}], " "}], 
   TraditionalForm]],ExpressionUUID->"4bcbfbca-c291-47db-a234-49035a5553f7"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "k"], ",", 
    SubscriptBox[
     OverscriptBox["z", "_"], "k"], " "}], TraditionalForm]],ExpressionUUID->
  "3f5b3785-2d69-4d01-b2bd-3c52e261841f"],
 " are a pair of conjugate roots, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "1"], TraditionalForm]],ExpressionUUID->
  "b0ee8d9e-821c-4989-bcdd-8870883df1ea"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "2"], TraditionalForm]],ExpressionUUID->
  "64808402-848d-40b4-b0f3-142ec10bd49d"],
 " are real roots."
}], "Text",
 CellChangeTimes->{{3.759873201778457*^9, 3.7598733130349245`*^9}, {
  3.7599450488913283`*^9, 
  3.7599451459525986`*^9}},ExpressionUUID->"996c5f39-3207-4a2d-addd-\
0ee5bef71541"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Linear system transfer function", "Section",
 CellChangeTimes->{{3.7598717631494703`*^9, 3.7598717859933796`*^9}, {
  3.759872414168935*^9, 3.759872452806572*^9}, {3.7598725082453637`*^9, 
  3.759872524523744*^9}, {3.7598731478616943`*^9, 3.759873158973068*^9}, {
  3.759873335036065*^9, 
  3.759873369436039*^9}},ExpressionUUID->"b568f842-45b6-4ac3-81ad-\
2769af8ed74b"],

Cell[TextData[{
 "In this course, the reason we are interested in the polynomial is that it \
can be used to represent the Laplaced-transformed response or transfer \
function of a linear system.\n(please review course materials of ",
 StyleBox["circuit analysis",
  FontWeight->"Bold"],
 ", ",
 StyleBox["signal analysis",
  FontWeight->"Bold"],
 ", or ",
 StyleBox["signals and systems",
  FontWeight->"Bold"],
 ")"
}], "Text",
 CellChangeTimes->{{3.7599451544169273`*^9, 3.7599451723161488`*^9}, {
  3.7600233779493303`*^9, 3.760023430685321*^9}, {3.760030390098051*^9, 
  3.7600304418796253`*^9}},ExpressionUUID->"744a03c9-338a-428d-b6f1-\
076f0ffa773f"],

Cell["\<\
What determines the behavior of these circuits or linear systems? The roots \
(or poles) of their Laplace transfer/response functions.\
\>", "Text",
 CellChangeTimes->{{3.760030550627694*^9, 3.760030596196701*^9}},
 FontColor->GrayLevel[1],
 Background->RGBColor[
  0., 0.21568627450980393`, 
   0.],ExpressionUUID->"c7b57710-4f51-48f9-9c7c-8269ac56683f"],

Cell[CellGroupData[{

Cell["3.1 Example 1:", "Subsection",
 CellChangeTimes->{{3.7600234777523108`*^9, 3.760023490375541*^9}, {
  3.7600306004394493`*^9, 3.760030600865307*^9}, {3.760031191990845*^9, 
  3.7600311954187717`*^9}, {3.7600327812342567`*^9, 
  3.7600327832248335`*^9}},ExpressionUUID->"f6ec5f33-c5b4-4bfa-834b-\
87ec63f09caf"],

Cell["\<\
Please go to this website to watch the behavior of second-order circuits as \
functions of the Laplace TF poles.\
\>", "Text",
 CellChangeTimes->{{3.7600234966487923`*^9, 3.7600235046694*^9}, {
  3.760030621545915*^9, 3.7600306728257046`*^9}, {3.760031143019888*^9, 
