   3.787881352190534*^9, 3.7878813544145575`*^9}, 
   3.787883872412683*^9},ExpressionUUID->"ff8c8782-111b-4941-b512-\
afe771eca690"],

Cell["\<\
A 500-\[Mu]F capacitor is fully charged with 10 V. At time t=0, it is allowed \
to suddenly discharge into a 2-k\[CapitalOmega] resistor. What is the voltage \
and current at time t=1.5 sec? \
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.755703499419217*^9, 3.755703508323343*^9}, {
   3.755707162923955*^9, 3.7557072131918726`*^9}, 3.755862495462262*^9, {
   3.7878813697375793`*^9, 
   3.787881373837713*^9}},ExpressionUUID->"e77f45be-6a6c-47e9-9b90-\
aeb0f0aec960"]
}, Open  ]],

