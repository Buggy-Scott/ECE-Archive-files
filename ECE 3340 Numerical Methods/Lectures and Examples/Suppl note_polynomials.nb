  RowBox[{"Transpose", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.75", ",", "1.", ",", "2.2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.9", ",", "0.4", ",", "0.05"}], "}"}]}], "}"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.7601246767666616`*^9, 3.76012478460318*^9}},
