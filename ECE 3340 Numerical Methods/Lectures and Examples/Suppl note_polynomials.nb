Cell["\<\
We see that it is just a list of 6 roots as expected. Now we are ready to \
construct the polynomial:\
\>", "Text",
 CellChangeTimes->{{3.7601239346700783`*^9, 
  3.7601239623909903`*^9}},ExpressionUUID->"5875d221-e09f-47a3-9dfb-\
d0d3b0017fe7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rootAll", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"singleroot", ",", "rootpr1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"polyn", "=", 
  RowBox[{"Product", "[", 
   RowBox[{
    RowBox[{"s", "-", "u"}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", "rootAll"}], "}"}]}], "]"}], " "}]}], "Input",
