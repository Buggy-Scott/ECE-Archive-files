  3.760123697719346*^9, 
  3.7601237053518333`*^9}},ExpressionUUID->"9c7c6458-3265-4008-8ad1-\
c281df14a4a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rootpr", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"rootpairF", "[", "u", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", "pairrootparm"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7601237114225936`*^9, 3.7601237824715242`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"3d43fa8f-4411-465e-925a-f6d5cf4999a8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[Eta]1"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["\[Eta]1", "2"]}]]}]}], ")"}], " ", "\[Omega]1"}], 
     ",", 
