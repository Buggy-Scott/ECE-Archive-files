   3.7878857936594777`*^9, 3.7878857942368364`*^9}, {3.787886439659402*^9, 
   3.7878864401400485`*^9}},ExpressionUUID->"2c9ae22d-0339-4334-9e25-\
7457f131e6e5"],

Cell[TextData[{
 "Consider an EM wave ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "[", 
     RowBox[{"z", ",", "t"}], "]"}], "=", 
    RowBox[{
     SubscriptBox["E", "0"], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "\[Pi]", " ", "f", " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["z", "c"], "-", "t"}], ")"}]}], "]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"d80dedf3-1639-496f-8f09-2910b4860b62"],
 "\nwhere f=2450 MHz; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "0"], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "f5172e47-5e61-4bed-af24-7e800ced1d0a"],
 ". What is the E field at z=0 for t=1, 2, 3, 4 sec"
}], "Text",
 CellChangeTimes->{{3.7878872655017505`*^9, 3.787887278371334*^9}, {
  3.7878874685009184`*^9, 
  3.7878876104223723`*^9}},ExpressionUUID->"f8807bb0-aa91-49cb-886f-\
f636a9dbc5de"],

