Cell["Now we can define the low-pass, hi-pass, and band-pass TF:", "Text",
 CellChangeTimes->{{3.760126823219003*^9, 3.7601268407331495`*^9}, {
  3.760126903639968*^9, 
  3.760126920251425*^9}},ExpressionUUID->"c56b4d9d-0bf9-4ef5-95a0-\
811d49c191f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tflo", "=", 
   RowBox[{"Product", "[", 
    RowBox[{
     FractionBox["\[Omega]n2", 
      RowBox[{"s", "-", "u"}]], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "root2"}], "}"}]}], "  ", "]"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tfhi", "=", 
   RowBox[{"Product", "[", 
    RowBox[{
     FractionBox["s", 
      RowBox[{"s", "-", "u"}]], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "root1"}], " ", "}"}]}], "]"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tfbp", "=", 
   RowBox[{"tfhi", "*", "tflo"}]}], " ", ";"}]}], "Input",
 CellChangeTimes->{{3.7601268549112215`*^9, 3.760126897605008*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"bc334b6f-34d9-4f27-bf57-788f33bcc287"],

Cell["We can put all into a function:", "Text",
 CellChangeTimes->{{3.7601269468622365`*^9, 
  3.76012695973989*^9}},ExpressionUUID->"b05b0465-fdb2-4984-9153-\
8331f16da053"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FilterTFdesign", "[", 
    RowBox[{"{", 
     RowBox[{"yr_", ",", "mon_", ",", "date_"}], "}"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Omega]L", ",", "\[Eta]L", ",", "\[Omega]n1", ",", "\[Omega]n2", 
       "\[IndentingNewLine]", ",", "\[Eta]a", ",", "\[Eta]b", ",", "allroots",
        ",", "roots", ",", "root1", ",", "root2", ",", "tfhi", ",", "tflo", 
       ",", "tfbp"}], "}"}], "\[IndentingNewLine]", ",", " ", 
     RowBox[{
      RowBox[{"ClearAll", "[", "s", "]"}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "s", " ", "global", " ", "is", " ", "clear", " ", "so", " ", "that", 
        " ", "is", " ", "Block", " ", "has", " ", "exclusive", " ", 
        "control"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"\[Omega]n1", "=", 
       RowBox[{"1.", "+", 
        RowBox[{"0.01", " ", "date"}]}]}], ";", 
      RowBox[{"\[Omega]n2", "=", 
       RowBox[{"\[Omega]n1", " ", 
        RowBox[{"(", 
         RowBox[{"1.2", "+", 
          RowBox[{"0.2", " ", 
           RowBox[{"Mod", "[", 
            RowBox[{"yr", ",", "10"}], "]"}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Eta]a", "=", 
       RowBox[{"Cos", "[", 
        RowBox[{
         FractionBox["mon", "25."], "\[Pi]"}], "]"}]}], ";", 
      RowBox[{"\[Eta]b", "=", 
       RowBox[{"Cos", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"mon", "+", "6"}], ",", "12"}], "]"}], "25."], "\[Pi]"}], 
        "]"}]}], ";", " ", "\[IndentingNewLine]", 
      RowBox[{"\[Omega]L", "=", 
       RowBox[{"{", 
        RowBox[{"\[Omega]n1", ",", "\[Omega]n2"}], "}"}]}], ";", 
      RowBox[{"\[Eta]L", "=", 
       RowBox[{"{", 
        RowBox[{"\[Eta]a", ",", "\[Eta]b"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"allroots", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"rootpairF", "[", 
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "\[Omega]L"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "\[Eta]L"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"root1", ",", "root2"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Flatten", " ", "@", " ", 
          RowBox[{"allroots", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"Flatten", " ", "@", " ", 
          RowBox[{"allroots", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "this", " ", "is", " ", "the", " ", "output", " ", "list", " ", "of", 
        " ", "this", " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"root1", ",", "root2"}], "}"}], "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"1", "st", " ", 
          RowBox[{"element", ":", " ", 
           RowBox[{
           "a", " ", "list", " ", "of", " ", "root1", " ", "and", " ", 
            "root2"}]}]}], " ", "*)"}], "\[IndentingNewLine]", ",", 
        RowBox[{"tflo", "=", 
         RowBox[{"Product", "[", 
          RowBox[{
           FractionBox["\[Omega]n2", 
            RowBox[{"s", "-", "u"}]], ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "root2"}], "}"}]}], "]"}]}], "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"2", "nd", " ", "element"}], " ", "*)"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"tfhi", "=", 
         RowBox[{"Product", "[", 
          RowBox[{
           FractionBox["s", 
            RowBox[{"s", "-", "u"}]], ",", 
           RowBox[{"{", 
            RowBox[{"u", ",", "root1"}], "}"}]}], "]"}]}], "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"3", "rd", " ", "element"}], " ", "*)"}], 
        "\[IndentingNewLine]", ",", " ", 
        RowBox[{"tfbp", "=", 
         RowBox[{"tfhi", "*", "tflo"}]}]}], "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"4", "th", " ", "element"}], " ", "*)"}], 
       "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.7601274559383087`*^9, 3.7601274832721853`*^9}, {
  3.7601275514478035`*^9, 3.76012762954565*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"ff6bde5f-07d0-48cc-8c48-4b8be30ac989"],

