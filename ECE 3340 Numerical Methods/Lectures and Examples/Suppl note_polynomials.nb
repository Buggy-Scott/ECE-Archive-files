Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xrange", ",", "yrange"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1.5", "*", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Re", "[", "rootAll", "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"1.2", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Im", "[", "rootAll", "]"}], "]"}], "]"}]}]}], "}"}]}], ";", 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "maximum", " ", "x", " ", "and", " ", "y", " ", "of", " ", 
     "all", " ", "roots"}], ",", " ", 
    RowBox[{
    "multiple", " ", "extra", " ", "margin", " ", "to", " ", "set", " ", 
     "plot", " ", "region"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{"10.", 
     RowBox[{"Log", "[", 
      RowBox[{"10.", ",", 
       RowBox[{"Abs", "[", 
        RowBox[{
         FractionBox["1", "polyn"], "/.", " ", 
         RowBox[{"s", "\[Rule]", " ", 
          RowBox[{"x", "+", 
           RowBox[{"\[ImaginaryI]", " ", "y"}]}]}]}], "]"}]}], "]"}]}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "xrange"}], ",", 
      RowBox[{"0.1", "xrange"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "yrange"}], ",", "yrange"}], "}"}], "\[IndentingNewLine]", 
    ",", 
    RowBox[{"ColorFunction", "\[Rule]", "\"\<BrightBands\>\""}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"MeshFunctions", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#3", "&"}], " ", ",", 
       RowBox[{"Function", " ", "@@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], "\[IndentingNewLine]", 
          ",", 
          RowBox[{"Arg", "[", 
           RowBox[{
            FractionBox["1", "polyn"], " ", "/.", " ", 
            RowBox[{"s", "\[Rule]", " ", 
             RowBox[{"x", "+", 
              RowBox[{"\[ImaginaryI]", " ", "y"}]}]}]}], "]"}]}], "}"}]}]}], 
      " ", "}"}]}], "\[IndentingNewLine]", ",", 
    RowBox[{"MeshStyle", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.001", "]"}], ",", "Orange"}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.001", "]"}], ",", 
         RowBox[{"GrayLevel", "[", "0.75", "]"}]}], "}"}]}], "}"}]}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xrange", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0.1"}], "}"}]}], ",", 
       RowBox[{"yrange", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", 
