 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "\[Eta]a"}], "+", 
          RowBox[{"\[ImaginaryI]", " ", 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["\[Eta]a", "2"]}]]}]}], ")"}], " ", 
        "\[Omega]n1"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "\[Eta]a"}], "-", 
          RowBox[{"\[ImaginaryI]", " ", 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["\[Eta]a", "2"]}]]}]}], ")"}], " ", 
        "\[Omega]n1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "\[Eta]b"}], "+", 
