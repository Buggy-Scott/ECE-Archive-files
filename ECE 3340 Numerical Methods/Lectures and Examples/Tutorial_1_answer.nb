Cell[TextData[{
 "What if we want to \[OpenCurlyDoubleQuote]undo\[CloseCurlyDoubleQuote] the \
assignment of a variable? We can use ",
 StyleBox["Clear",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 ", ",
 StyleBox["ClearAll",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 ", ",
 StyleBox["Remove",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 ", or assignment ",
 StyleBox[" =.",
  FontFamily->"Consolas",
  FontWeight->"Bold"]
}], "Text",
