Cell["\<\
Notice that we define the polynomial with formulated roots, but not numeric \
values. Yet, as soon as we assign numeric values to the various root \
parameters, Mathematica will substitute numerical values into those symbols \
and we can plot the actual function.\
\>", "Text",
 CellChangeTimes->{{3.760125581661867*^9, 
  3.7601256916646247`*^9}},ExpressionUUID->"974c564a-ba17-4421-8acf-\
af118eb80991"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xrange", ",", "yrange"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1.5", "*", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Re", "[", "rootAll", "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"1.2", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"Im", "[", "rootAll", "]"}], "]"}], "]"}]}]}], "}"}]}], ";", 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "maximum", " ", "x", " ", "and", " ", "y", " ", "of", " ", 
     "all", " ", "roots"}], ",", " ", 
    RowBox[{
    "multiple", " ", "extra", " ", "margin", " ", "to", " ", "set", " ", 
     "plot", " ", "region"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{"10.", 
     RowBox[{"Log", "[", 
      RowBox[{"10.", ",", 
       RowBox[{"Abs", "[", 
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"s", "+", "0.25"}], ")"}], "3"], "polyn"], "/.", " ", 
         RowBox[{"s", "\[Rule]", " ", 
          RowBox[{"x", "+", 
           RowBox[{"\[ImaginaryI]", " ", "y"}]}]}]}], "]"}]}], "]"}]}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "xrange"}], ",", 
      RowBox[{"0.1", "xrange"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "yrange"}], ",", "yrange"}], "}"}], "\[IndentingNewLine]", 
    ",", 
    RowBox[{"ColorFunction", "\[Rule]", "\"\<BrightBands\>\""}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"MeshFunctions", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#3", "&"}], " ", ",", 
       RowBox[{"Function", " ", "@@", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], "\[IndentingNewLine]", 
          ",", 
          RowBox[{"Arg", "[", 
           RowBox[{
            FractionBox[
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"s", "+", "0.25"}], ")"}], "3"], "polyn"], " ", "/.", 
            " ", 
            RowBox[{"s", "\[Rule]", " ", 
             RowBox[{"x", "+", 
              RowBox[{"\[ImaginaryI]", " ", "y"}]}]}]}], "]"}]}], "}"}]}]}], 
      " ", "}"}]}], "\[IndentingNewLine]", ",", 
    RowBox[{"MeshStyle", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.001", "]"}], ",", "Orange"}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.001", "]"}], ",", 
         RowBox[{"GrayLevel", "[", "0.75", "]"}]}], "}"}]}], "}"}]}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xrange", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0.1"}], "}"}]}], ",", 
       RowBox[{"yrange", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "20"}], ",", "20"}], "}"}]}], "}"}]}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"PlotPoints", "\[Rule]", "80"}], ",", " ", 
    RowBox[{"BoxRatios", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1.1", " ", "xrange"}], ",", 
       RowBox[{"2", " ", "yrange"}], ",", 
       RowBox[{"1.5", "xrange"}]}], "}"}]}], "\[IndentingNewLine]", ",", 
    RowBox[{"Background", "\[Rule]", "Black"}], ",", " ", 
    RowBox[{"ImageSize", "\[Rule]", "350"}]}], "]"}], " "}]], "Input",
