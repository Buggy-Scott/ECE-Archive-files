Cell[CellGroupData[{

Cell["4. Example of coding for transfer functions", "Section",
 CellChangeTimes->{{3.7598717631494703`*^9, 3.7598717859933796`*^9}, {
  3.759872414168935*^9, 3.759872452806572*^9}, {3.7598725082453637`*^9, 
  3.759872524523744*^9}, {3.7598731478616943`*^9, 3.759873158973068*^9}, {
  3.759873335036065*^9, 3.759873369436039*^9}, {3.7601189621737385`*^9, 
  3.7601189868906174`*^9}},ExpressionUUID->"5121ee1f-22f7-4f59-9f60-\
1d750f4951c8"],

Cell[CellGroupData[{

Cell["4.1 Usage of Product function", "Subsection",
 CellChangeTimes->{{3.760120660695407*^9, 
  3.760120678211548*^9}},ExpressionUUID->"3949d994-2f76-4379-82d4-\
729e13870a07"],

Cell[TextData[{
 "In general, a transfer function can be written as:\n             ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"P", "[", "s", "]"}], 
     RowBox[{"Q", "[", "s", "]"}]], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"s", "-", 
          SubscriptBox["u", "1"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"s", "-", 
          SubscriptBox["u", "2"]}], ")"}]}], " ", "..."}], 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"s", "-", 
          SubscriptBox["v", "1"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"s", "-", 
          SubscriptBox["v", "2"]}], ")"}]}], " ", "..."}]], "  ", "=", "   ", 
     FractionBox[
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"i", "=", "1"}], "p"], 
       RowBox[{"(", 
        RowBox[{"s", "-", 
         SubscriptBox["u", "i"]}], ")"}]}], 
      RowBox[{
       UnderoverscriptBox["\[Product]", 
        RowBox[{"j", "=", "1"}], "q"], 
       RowBox[{"(", 
        RowBox[{"s", "-", 
         SubscriptBox["v", "j"]}], ")"}]}]], "  "}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "6f6dbb59-c2e1-4412-ba64-6994841c5032"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "i"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "951c3ec2-518f-427a-b5d4-34be139d63e0"],
 ", i from 1 to p and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "j"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d3111a66-9092-47e5-acf7-1e48d8580e30"],
 ", j from 1 to q are the roots of the numerator and the denominator."
}], "Text",
 CellChangeTimes->{{3.76011980664425*^9, 3.760119845174097*^9}, {
  3.7601200269396114`*^9, 3.7601200904949207`*^9}, {3.7601201286130266`*^9, 
  3.760120150509192*^9}, {3.760120268830388*^9, 3.7601203689296474`*^9}, {
  3.7601206886256886`*^9, 3.760120767682179*^9}, {3.760120839840148*^9, 
  3.7601208401204624`*^9}},ExpressionUUID->"f286cffc-7895-4f9d-95cf-\
00c6842bde12"],

Cell[TextData[{
 "The mathematical symbol, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Product]", 
     RowBox[{"i", "=", "1"}], "p"], 
    RowBox[{"(", 
     RowBox[{"s", "-", 
      SubscriptBox["u", "i"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "70b6df62-afb9-4416-ba4f-eb996042c4d7"],
 " is known as \[OpenCurlyDoubleQuote]product\[CloseCurlyDoubleQuote] and it \
can be used directly in Mathematica code:"
}], "Text",
 CellChangeTimes->{{3.7601203802284064`*^9, 
  3.7601204264852443`*^9}},ExpressionUUID->"ca421e85-d40d-40c3-869a-\
d36b1632887a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "2", ",", 
     RowBox[{"-", "3"}], ",", "5", ",", "6"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 FormBox[
  RowBox[{
   UnderoverscriptBox["\[Product]", 
    RowBox[{"i", "=", "1"}], 
    RowBox[{"Length", "[", "u", "]"}]], 
   RowBox[{"(", 
    RowBox[{"s", "-", 
     RowBox[{"u", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ")"}], " "}],
  TraditionalForm]}], "Input",
 CellChangeTimes->{{3.7601204356008606`*^9, 3.7601205275249176`*^9}, {
  3.760120615560152*^9, 
  3.76012062024462*^9}},ExpressionUUID->"e5579adb-7ac6-4866-b253-\
f796e0366562"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "6"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "5"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "3"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"3", "+", "s"}], ")"}]}]], "Output",
 CellChangeTimes->{3.7601205205814915`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"ab3b7a19-d134-4d69-b592-d7f65fc45cf1"]
}, Open  ]],

Cell["\<\
To explicitly spell out the function without using the symbol, we can write:\
\>", "Text",
 CellChangeTimes->{{3.7601205563737545`*^9, 
  3.760120574805532*^9}},ExpressionUUID->"101bc4d6-3180-495c-b357-\
431f7378ba1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Product", "[", 
  RowBox[{
   RowBox[{"s", "-", "x"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "u"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7601205817059727`*^9, 3.760120632980549*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"884524d6-43a8-42b6-b93f-4a57cbba7703"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "6"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "5"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "3"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"3", "+", "s"}], ")"}]}]], "Output",
 CellChangeTimes->{3.76012063631765*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"30da50b6-a888-4296-b17e-d655481ab154"]
}, Open  ]],

Cell["\<\
Hence, suppose we have a list of roots, we can easily construct the TF \
programmatically. Below is an example.\
\>", "Text",
 CellChangeTimes->{{3.7601208714342346`*^9, 3.760120875755577*^9}, {
  3.7601211742731657`*^9, 
  3.760121207480331*^9}},ExpressionUUID->"1d1dc1ad-3c7b-4ed9-98f8-\
d1e8b73adbf1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Example 1", "Subsection",
 CellChangeTimes->{{3.760120660695407*^9, 3.760120678211548*^9}, {
  3.760121226488683*^9, 3.760121237086337*^9}, {3.7601246364784403`*^9, 
  3.760124638666686*^9}},ExpressionUUID->"a9950047-9903-4654-8e76-\
ee1f6ed46afa"],

Cell[TextData[{
 "Suppose we have a list of desired ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Omega]", "n"], ",", "\[Eta]"}], "}"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "9cc82ce8-6e32-4a90-a2b9-9f3370a922f9"],
 ", we first define function for the roots:"
}], "Text",
 CellChangeTimes->{{3.760121601791112*^9, 
  3.760121651530955*^9}},ExpressionUUID->"c8cb034d-fa33-4619-8915-\
941d4f7934cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rootpairF", "[", 
    RowBox[{"{", 
     RowBox[{"\[Omega]_", ",", "\[Eta]_"}], "}"}], "]"}], ":=", 
   RowBox[{"\[Omega]", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[Eta]"}], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["\[Eta]", "2"]}]]}]}], ",", 
      RowBox[{
       RowBox[{"-", "\[Eta]"}], "-", 
       RowBox[{"\[ImaginaryI]", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["\[Eta]", "2"]}]]}]}]}], "}"}]}]}], " ", 
  ";"}]], "Input",
 CellChangeTimes->{{3.760121660821102*^9, 3.760121689060276*^9}, {
  3.7601230981138334`*^9, 3.7601231047834644`*^9}, {3.7601232055856037`*^9, 
  3.760123212286837*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"b2f7564f-1e3b-47cf-8f8b-3ae16597adb5"],

Cell[TextData[{
 "\nWhat if it is a single real root? then we just use the root directly. So \
let the list of single real roots and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Omega]", "n"], ",", "\[Eta]"}], "}"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "064d0664-6f94-4790-8970-c4e48794fba5"],
 " be:"
}], "Text",
 CellChangeTimes->{{3.7601232184413376`*^9, 
  3.7601232910431156`*^9}},ExpressionUUID->"5864cb03-1dea-43a4-8302-\
ddbe577f2ca4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"singleroot", "=", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pairrootparm", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Omega]1", ",", "\[Eta]1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Omega]2", ",", "\[Eta]2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Omega]3", ",", "\[Eta]3"}], "}"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.7601232960038443`*^9, 3.7601234024642434`*^9}, {
