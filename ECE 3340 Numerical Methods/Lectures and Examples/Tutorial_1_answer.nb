Cell[TextData[{
 "Calculate the power of an LED in unit of mW with the following voltages and \
currents:\n- 3.6 V and 25 mA\n- 2.5 V and 30 mA\n- 1.9 V and 42 mA\nusing \
formula and substitution method (",
 StyleBox["/.",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
