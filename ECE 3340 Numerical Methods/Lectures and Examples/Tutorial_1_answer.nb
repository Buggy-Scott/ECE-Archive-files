Cell[CellGroupData[{

Cell["\<\
2.4 Using non-numerical or unassigned variables with ReplaceAll\
\>", "Subsection",
 CellChangeTimes->{{3.754915638138*^9, 3.754915642538*^9}, {3.75491585001*^9, 
   3.7549158548570004`*^9}, {3.754916393994*^9, 3.7549164013059998`*^9}, {
   3.7549166082980003`*^9, 3.754916620442*^9}, {3.7557019312709465`*^9, 
   3.7557019676998777`*^9}, {3.755862772276741*^9, 3.7558627777173023`*^9}, {
   3.7558631689288616`*^9, 3.7558631717407007`*^9}, 3.7878448801606846`*^9, {
   3.787845001120297*^9, 
   3.787845002016832*^9}},ExpressionUUID->"d4deba89-5f88-409d-999b-\
a52102dbb667"],

Cell[TextData[{
 "In the above, we obtain answers with unit ",
 StyleBox["mA Volt",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 ". But we want to transform the unit to mW. How do we do it? "
}], "Text",
 CellChangeTimes->{{3.754916412186*^9, 3.754916461178*^9}, {
  3.7557024119703803`*^9, 
  3.755702431356446*^9}},ExpressionUUID->"4df54b2a-c5c4-4287-9ea4-\
d15db00d9950"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"voltage", "=."}], ";", " ", 
  RowBox[{"current", "=."}], ";", 
  RowBox[{"power", "=."}], ";", " ", 
  RowBox[{"Volt", "=."}], ";", " ", 
  RowBox[{"mA", "=."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"power", "=", 
    RowBox[{"voltage", " ", "current"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"any", " ", "space"}], ",", " ", 
    RowBox[{
    "by", " ", "default", " ", "is", " ", "a", " ", "multiplication"}]}], 
   "  ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"voltage", "=", 
   RowBox[{"5.2", " ", "Volt"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"current", "=", 
   RowBox[{"2.5", " ", "mA"}]}], " ", 
  ";"}], "\[IndentingNewLine]", "power"}], "Input",
 CellChangeTimes->{{3.754916482146*^9, 3.75491648273*^9}, {
  3.755702494815485*^9, 3.7557025084060383`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"4773bf2e-b03b-4a6e-9875-016070fb22e0"],

Cell[BoxData[
 RowBox[{"13.`", " ", "mA", " ", "Volt"}]], "Output",
 CellChangeTimes->{3.754916483634*^9, 3.755702510624196*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"05dcb4f7-7b74-4300-8b51-a19d70d8e782"]
}, Open  ]],

Cell[TextData[{
 "In the above, ",
 StyleBox["mA",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 " and ",
 StyleBox["Volt",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 " are variables without any numerical assignment. We do so deliberately \
because we want to treat them as units."
}], "Text",
 CellChangeTimes->{{3.7558628044141483`*^9, 
  3.755862934630786*^9}},ExpressionUUID->"35bbb9a1-9c0a-4436-8cbb-\
769e35859ed6"],

Cell["This is how to can transform variables:", "Text",
 CellChangeTimes->{{3.755702526524989*^9, 3.7557025701596537`*^9}, {
  3.755862951017556*^9, 
  3.7558629666580877`*^9}},ExpressionUUID->"2e70b135-fbca-41d8-901c-\
017fed452209"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"power", " ", "/.", " ", 
  RowBox[{
   RowBox[{"mA", " ", "Volt"}], "\[Rule]", " ", "mW"}]}]], "Input",
 CellChangeTimes->{{3.754916486097*^9, 3.754916497866*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"b72cc69c-f8b5-4a85-949d-cdeef3d0e04a"],

Cell[BoxData[
 RowBox[{"13.`", " ", "mW"}]], "Output",
 CellChangeTimes->{3.754916498664*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"404a7be3-7005-4995-85ce-b12c2a0a3c50"]
}, Open  ]],

Cell[TextData[{
 StyleBox["/.",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 " is known as ",
 StyleBox["ReplaceAll",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 ": it is a function allowing us to replace some symbol (unassigned variable) \
with something. Consider this example:"
}], "Text",
 CellChangeTimes->{{3.7549165461219997`*^9, 3.754916558234*^9}, {
  3.754916627514*^9, 3.754916652299*^9}, {3.754917881658*^9, 
  3.754917886665*^9}, {3.7557025887177877`*^9, 3.755702605635689*^9}, {
  3.7558629919490805`*^9, 
  3.7558629993692074`*^9}},ExpressionUUID->"22b89654-e70f-4210-83de-\
886088fd4777"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=."}], ";", " ", 
  RowBox[{"b", "=."}], ";", " ", 
  RowBox[{"q", "=."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "*", 
   SuperscriptBox["b", "2"]}], " ", "/.", " ", 
  RowBox[{"b", "\[Rule]", " ", "q"}]}]}], "Input",
 CellChangeTimes->{{3.754916729251*^9, 3.754916746138*^9}, {
  3.7549167763310003`*^9, 3.7549168273380003`*^9}, {3.7557026202884955`*^9, 
  3.755702638665239*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"a5a42415-3aa6-4ea5-8511-53d68e0f6f3b"],

Cell[BoxData[
 RowBox[{"a", " ", 
  SuperscriptBox["q", "2"]}]], "Output",
 CellChangeTimes->{
  3.754916747417*^9, {3.7549168138050003`*^9, 3.754916828113*^9}, 
   3.755702639586829*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"e96c7933-12e9-45f4-b537-ff6827255eae"]
}, Open  ]],

Cell[TextData[{
 "However, if we already assign a ",
 StyleBox["numerical",
  FontWeight->"Bold"],
 " value of b:"
}], "Text",
 CellChangeTimes->{{3.754920599066*^9, 
  3.754920612426*^9}},ExpressionUUID->"c41d3234-a577-43b5-8883-f57c80e73b4e"],

