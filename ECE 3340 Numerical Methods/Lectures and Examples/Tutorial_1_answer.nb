Cell["\<\
What is the rms current for the circuit with 3 appliances in the question \
above: 1600-W toaster, 1800-W fryer, and 1500-W water boiler, assuming that \
the voltage is 120-V AC. (irms=P/V) \
\>", "Text",
 CellChangeTimes->{{3.787879005901638*^9, 3.787879008671232*^9}, {
  3.787879051376026*^9, 
  3.787879073600591*^9}},ExpressionUUID->"e734dcad-4e19-456d-a230-\
a4684f7afae6"],

Cell["Answer", "Answer",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.754915178682*^9, 3.754915179802*^9}, {3.754915362314*^9,
    3.754915377962*^9}, {3.754915872859*^9, 3.7549158808900003`*^9}, 
   3.755864686282528*^9},ExpressionUUID->"dc4eb551-e537-4283-b5f7-\
9868767d10e0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"toaster", "=."}], ";", " ", 
  RowBox[{"fryer", "=."}], ";", " ", 
  RowBox[{"boiler", "=."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"totalpower", "=", 
   RowBox[{"toaster", "+", "fryer", "+", "boiler"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
