Cell["Similar to most languages, power operation is done with ^", "Text",
 CellChangeTimes->{{3.7557029564683747`*^9, 
  3.755702983758831*^9}},ExpressionUUID->"bf447082-f350-4f91-acdb-\
06084498b208"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resistance", "=."}], ";", " ", 
  RowBox[{"current", "=."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"powerRI", "=", 
   RowBox[{"resistance", " ", 
    RowBox[{"current", "^", "2"}]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"resistance", "=", 
   RowBox[{"100", " ", "\[CapitalOmega]"}]}], " ", ";", " ", 
  RowBox[{"current", "=", 
   RowBox[{"50", " ", "mA"}]}], 
  ";"}], "\[IndentingNewLine]", "powerRI"}], "Input",
