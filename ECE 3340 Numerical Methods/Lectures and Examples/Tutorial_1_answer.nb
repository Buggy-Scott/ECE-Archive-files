    RowBox[{"(", 
     RowBox[{"-", "t"}], ")"}]}], "]"}], " ", "/.", " ", 
  RowBox[{"t", "\[Rule]", " ", "3."}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sin", "[", 
   RowBox[{"2", " ", "\[Pi]", " ", "f", " ", 
    RowBox[{"(", 
     RowBox[{"-", "t"}], ")"}]}], "]"}], " ", "/.", " ", 
  RowBox[{"t", "\[Rule]", " ", "4."}]}]}], "Input",
