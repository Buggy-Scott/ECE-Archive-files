Cell[TextData[{
 "We don\[CloseCurlyQuote]t see anything different because it cannot be \
computed numerically. But we can use function ",
 StyleBox["Expand[]",
  FontFamily->"Consolas",
  FontWeight->"Bold"],
 " to do symbolic manipulation:"
}], "Text",
 CellChangeTimes->{{3.75570689859604*^9, 3.755706965934766*^9}, {
  3.7557070941467667`*^9, 3.7557070943186007`*^9}, {3.755862198742793*^9, 
  3.755862211849087*^9}},ExpressionUUID->"146f5a72-0070-41bc-b8d9-\
a6825a5a6db9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Phi]", "=."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Expand", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "-", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], "+", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.75570699021023*^9, 3.7557070112989845`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"6ee1f13f-5cd5-42c2-be20-b29eded0204b"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"], "-", 
  SuperscriptBox[
   RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]], "Output",
 CellChangeTimes->{3.7557070128298073`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"ff84b1c2-160f-4b15-a6d6-78d2f9df351d"]
}, Open  ]],

