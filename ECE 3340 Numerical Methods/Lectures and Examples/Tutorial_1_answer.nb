Cell["Exercise 3.7", "Exercise",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.754914553098*^9, 3.754914557434*^9}, 
   3.754915872859*^9, {3.7554553590950003`*^9, 3.755455361256*^9}, 
