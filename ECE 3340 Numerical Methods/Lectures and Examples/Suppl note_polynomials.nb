Cell[CellGroupData[{

Cell["4.3 Example 3", "Subsection",
 CellChangeTimes->{{3.7601260241843624`*^9, 
  3.7601260405670986`*^9}},ExpressionUUID->"83890327-661f-42d8-91ed-\
c2677976d9e9"],

Cell["\<\
This example is from HW3,
Let the lists of natural frequency and damping coefficient be:\
\>", "Text",
 CellChangeTimes->{{3.760126062704869*^9, 
  3.7601261241968665`*^9}},ExpressionUUID->"8902e808-bb78-4ab6-ae54-\
d157d523d566"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]L", "=", 
    RowBox[{"{", 
     RowBox[{"\[Omega]n1", ",", "\[Omega]n2"}], "}"}]}], ";", 
   RowBox[{"\[Eta]L", "=", 
    RowBox[{"{", 
     RowBox[{"\[Eta]a", ",", "\[Eta]b"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "now", " ", "we", " ", "can", " ", "create", " ", "a", " ", "list", " ", 
     "of", " ", "all", " ", "roots"}], ",", " ", 
    RowBox[{"we", " ", "get", " ", "a", " ", "2", "x2", " ", "table"}], ",", 
    " ", 
    RowBox[{
    "each", " ", "is", " ", "another", " ", "list", " ", "of", " ", "2", " ", 
     "roots"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"allroots", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"rootpairF", "[", 
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", "\[Omega]L"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v", ",", "\[Eta]L"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.760121694929857*^9, 3.7601216966107955`*^9}, {
  3.76012605148427*^9, 3.760126077721084*^9}, {3.7601261568722577`*^9, 
  3.7601262008033085`*^9}, {3.760126354776697*^9, 3.760126407288722*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"d0fb6da4-8272-4d33-87ae-c29b071dd22e"],

