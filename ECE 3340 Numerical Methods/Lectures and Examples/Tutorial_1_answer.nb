Cell[TextData[{
 "This is known as Shift+Enter. Hold Shift key and hit Enter. It ONLY works \
on an \[OpenCurlyDoubleQuote]",
 StyleBox["input cell",
  FontWeight->"Bold"],
 ",\[CloseCurlyDoubleQuote] which is highlighted as light yellow in all these \
lessons. \nWhat does it do? it executes the codes in the selected ",
 StyleBox["input cell",
  FontWeight->"Bold"],
 ".\n"
}], "Text",
