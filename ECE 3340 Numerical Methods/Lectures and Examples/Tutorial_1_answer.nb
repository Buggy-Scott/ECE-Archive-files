 RowBox[{
  RowBox[{"vac", "=", "120."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"irms", "=", 
  RowBox[{"totalpower", "/", "vac"}]}]}], "Input",
 CellChangeTimes->{{3.755284738329*^9, 3.75528477356*^9}, {
   3.7552849609040003`*^9, 3.7552849688900003`*^9}, {3.755443854716*^9, 
