                    "}"}]}], ")"}]}], " ", "\[IndentingNewLine]", ",", 
               RowBox[{"Background", "\[Rule]", "Black"}], ",", " ", 
               RowBox[{"ImageSize", "\[Rule]", "350"}]}], "]"}], " ", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
             RowBox[{"LogLinearPlot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Arg", "[", 
                 RowBox[{"(", 
                  RowBox[{"tf", "/.", 
                   RowBox[{"var", "\[Rule]", " ", 
                    RowBox[{
                    "\[ImaginaryI]", " ", "2", " ", "\[Pi]", " ", "f"}]}]}], 
                  ")"}], "]"}], "/", "\[Pi]"}], "             ", 
               RowBox[{"(*", " ", 
                RowBox[{"3", "rd", " ", "element"}], " ", "*)"}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"{", 
                RowBox[{"f", ",", "0.001", ",", "100"}], "}"}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"PlotRange", "\[Rule]", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0.001", ",", "100"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "1.1"}], ",", "1.1"}], "}"}]}], "}"}]}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"PlotStyle", "\[Rule]", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Thickness", "[", "0.01", "]"}], ",", 
                  RowBox[{"Hue", "[", 
                   RowBox[{"0.17", ",", "1", ",", "1"}], "]"}]}], "}"}]}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"Filling", "\[Rule]", " ", 
                RowBox[{"{", 
                 RowBox[{"1", "\[Rule]", " ", 
