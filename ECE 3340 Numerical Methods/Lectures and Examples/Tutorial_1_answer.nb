  3.7549158808900003`*^9}},ExpressionUUID->"74355c0f-97e1-4d48-8ef2-\
1dfe3014d6c4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "=", 
   RowBox[{"2450", "*", 
    RowBox[{"10", "^", "6"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sin", "[", 
   RowBox[{"2", " ", "\[Pi]", " ", "f", " ", 
    RowBox[{"(", 
     RowBox[{"-", "t"}], ")"}]}], "]"}], " ", "/.", " ", 
  RowBox[{"t", "\[Rule]", " ", "1."}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sin", "[", 
   RowBox[{"2", " ", "\[Pi]", " ", "f", " ", 
    RowBox[{"(", 
