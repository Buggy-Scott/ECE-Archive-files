              Hue[0.15, 1, 1], 
              Arrow[{{0, 0}, {-0.4999999999999998, 0.8660254037844387}}]}}}, 
           Background -> GrayLevel[0], ImageSize -> 
           40]}; $CellContext`wfuncname = {
         " Cos(2 \[Pi] ", " Square(2 \[Pi] ", 
          " Triangle(2 \[Pi] "}; $CellContext`wavfunc[
          Pattern[$CellContext`i, 
           Blank[]], 
          Pattern[$CellContext`x, 
           Blank[]]] := If[$CellContext`i == 2, 
          Sign[
           Cos[$CellContext`x]], 
          If[$CellContext`i == 3, 
           If[
            OddQ[
             Floor[$CellContext`x/Pi]], 
            2 (Mod[$CellContext`x/Pi, 1] - 0.5), (-2) (
             Mod[$CellContext`x/Pi, 1] - 0.5)], 
           Cos[$CellContext`x]]]; $CellContext`phasorparm2 = {{0.003, 0.04, 
          0.001}, {0.16, 1, 1}, {
          0.09, 1, 1, 0.7}}; $CellContext`phasorparm1 = {{0.003, 0.04, 
